insert into public.sedes(id,name,slug,owner_id) values
  ('30000000-0000-0000-0000-000000000001','atomic own','atomic-own','00000000-0000-0000-0000-000000000001'),
  ('30000000-0000-0000-0000-000000000002','atomic foreign','atomic-foreign','00000000-0000-0000-0000-000000000002');
-- Seed real legacy projections before PR1, including homonyms and zero credit.
insert into public.students(id,sede_id,full_name,name,surname,student_category,classes_remaining,
  bonos_asignados,price,payment_status,membership_tier,membership_activated_at,expiry_date)
select ('10000000-0000-0000-0000-' || lpad(n::text,12,'0'))::uuid,
  case when n=8 then '30000000-0000-0000-0000-000000000002'::uuid else '30000000-0000-0000-0000-000000000001'::uuid end,
  'Alex Perez','Alex','Perez',case when n in (3,9) then 'temporal' else 'membresia' end,
  case when n=2 then 0 else 3 end,4,120,'paid','gold',
  (now() at time zone 'Europe/Madrid')::date-5, (now() at time zone 'Europe/Madrid')::date+15
from generate_series(1,9) n;
insert into public.students(id,sede_id,full_name,name,surname,student_category,classes_remaining,
  bonos_asignados,price,payment_status,membership_tier,membership_activated_at,expiry_date)
select '10000000-0000-0000-0000-000000abcdef',sede_id,full_name,name,surname,student_category,classes_remaining,
  bonos_asignados,price,payment_status,membership_tier,membership_activated_at,expiry_date
from public.students where id='10000000-0000-0000-0000-000000000005';
insert into public.sessions(id,sede_id,start_time,end_time,class_type,date,capacity)
select ('20000000-0000-0000-0000-' || lpad(n::text,12,'0'))::uuid,
  case when n=6 then '30000000-0000-0000-0000-000000000002'::uuid else '30000000-0000-0000-0000-000000000001'::uuid end,
  ((now() at time zone 'Europe/Madrid')::date::timestamp at time zone 'UTC')+make_interval(hours=>n*2),
  ((now() at time zone 'Europe/Madrid')::date::timestamp at time zone 'UTC')+make_interval(hours=>n*2+1),
  'mesa',(now() at time zone 'Europe/Madrid')::date::text,case when n=5 then 1 else 2 end
from generate_series(1,7) n;
insert into public.teachers(id,sede_id,name) values
  ('70000000-0000-0000-0000-000000000001','30000000-0000-0000-0000-000000000001','Original teacher'),
  ('70000000-0000-0000-0000-000000000002','30000000-0000-0000-0000-000000000001','Original substitute');
insert into public.sessions(id,sede_id,start_time,end_time,class_type,date,capacity,teacher_id,teacher_substitute_id)
select ('20000000-0000-0000-0000-' || lpad(n::text,12,'0'))::uuid,'30000000-0000-0000-0000-000000000001',
  ((now() at time zone 'Europe/Madrid')::date::timestamp at time zone 'UTC')+make_interval(days=>case when n=11 then 90 else 0 end,hours=>18),
  ((now() at time zone 'Europe/Madrid')::date::timestamp at time zone 'UTC')+make_interval(days=>case when n=11 then 90 else 0 end,hours=>19),
  'mesa',(now() at time zone 'Europe/Madrid')::date::text,2,
  case when n=12 then '70000000-0000-0000-0000-000000000001'::uuid end,
  case when n=12 then '70000000-0000-0000-0000-000000000002'::uuid end
from (values (11),(12)) extra(n);
insert into public.session_students(session_id,student_id,sede_id,student_name,attendance)
select ('20000000-0000-0000-0000-' || lpad(session::text,12,'0'))::uuid,
  ('10000000-0000-0000-0000-' || lpad(student::text,12,'0'))::uuid,
  case when session=6 then '30000000-0000-0000-0000-000000000002'::uuid else '30000000-0000-0000-0000-000000000001'::uuid end,
  'ALEX PEREZ',case when session=4 then 'present' else 'pending' end
from (values (1,1),(1,2),(2,1),(2,4),(3,3),(4,1),(6,8),(11,5),(12,9)) roster(session,student);
\i /tmp/atomic-membership.sql
\i /tmp/atomic-gift.sql
set role authenticated;
set request.jwt.claim.sub = '00000000-0000-0000-0000-000000000001';
select public.activate_student_membership(id) from public.students where student_category='membresia';
