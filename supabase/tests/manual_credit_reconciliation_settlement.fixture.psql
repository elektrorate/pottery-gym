select public.atomic_assert(count(*)=0,'unlinked reader cannot read credit profiles') from public.student_credit_profile;
set request.jwt.claim.sub = '01000000-0000-0000-0000-000000000005';
select public.atomic_reject($q$select public.manual_approve(100,100,'reconcile_legacy',3,3)$q$, 'Only this workshop owner may approve manual credits','42501');
select public.atomic_assert(count(*)=0,'linked integration cannot read manual entitlements') from public.student_manual_credit_entitlements;
set request.jwt.claim.sub = '01000000-0000-0000-0000-000000000002';
select public.atomic_reject($q$select public.manual_approve(100,100,'reconcile_legacy',3,3)$q$, 'Only this workshop owner may approve manual credits','42501');
select public.atomic_assert(count(*)=0,'foreign owner cannot read manual entitlements') from public.student_manual_credit_entitlements;
set request.jwt.claim.sub = '00000000-0000-0000-0000-000000000001';
select public.atomic_assert(bool_and(to_jsonb(st)=b.raw),'approvals preserve full raw balance, payment, archive, category and period')
  from public.students st join public.manual_students_before b using(id);
select public.atomic_assert(bool_and(c.legacy_snapshot=b.raw),'entitlements retain the complete raw preapproval student state')
  from public.student_manual_credit_entitlements c join public.manual_students_before b on b.id=c.student_id;
select public.atomic_assert(legacy_observed_balance is null and manual_credits->0->>'remaining_classes'='2'
  and legacy_raw_state->'payment_status'='"pending"'::jsonb,'unknown scalar remains unknown and manual ledger is separate')
  from public.student_credit_profile where student_id=public.business_id(1,101);
select public.atomic_assert(not exists(select 1 from public.student_membership_periods where student_id in
  (select public.business_id(1,n) from generate_series(100,160) n)), 'reconciliation never manufactures membership periods');
begin;
update public.students set classes_remaining=999 where id=public.business_id(1,100);
select public.atomic_assert(remaining_classes=3,'later scalar observation cannot change approved manual ledger balance')
  from public.manual_credit_entitlements_with_balance where entitlement_id=public.manual_entitlement(100,100);
select public.atomic_reject($q$select public.manual_approve(100,100,'reconcile_legacy',999,999)$q$, 'Idempotency key conflicts with original manual credit intent');
select public.atomic_reject($q$select public.manual_approve(100,200,'reconcile_legacy',999,999)$q$, 'Legacy balance is already reconciled');
rollback;

-- Even a real superadmin must be the actual current owner; integration ownership is insufficient.
reset role;
begin;
update public.sedes set owner_id=public.business_id(0,3) where id=public.business_id(3,1);
set local role authenticated;
set local request.jwt.claim.sub = '01000000-0000-0000-0000-000000000003';
