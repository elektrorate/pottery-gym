select public.atomic_reject($q$select public.manual_approve(100,100,'reconcile_legacy',3,3)$q$, 'Only this workshop owner may approve manual credits','42501');
rollback;
set role authenticated;
set request.jwt.claim.sub = '00000000-0000-0000-0000-000000000001';

-- Explicit source, never newest/manual fallback; courtesy cannot bypass an unselected valid grant.
select public.business_reserve(100,100,0,10);
select public.atomic_reject($q$select public.approve_session_exception(public.business_id(2,100),public.business_id(1,100),gen_random_uuid(),1,'no_credit','unselected manual')$q$,
  'No-credit exception cannot bypass available credit%');
select public.atomic_reject($q$select public.save_session_attendance(public.business_id(2,100),gen_random_uuid(),1,public.business_attendance(100,'present'),true,null)$q$,
  'Presence requires valid original credit%');
select public.atomic_reject($q$select public.save_session_reservation(public.business_id(2,100),gen_random_uuid(),1,public.business_id(3,1),'{}',
  array[public.business_id(1,100)],'{}',jsonb_build_object(public.business_id(1,100)::text,public.manual_entitlement(101,101)))$q$,
  'Explicit manual credit must belong to its roster student and session sede');
select public.atomic_reject($q$select public.save_session_reservation(public.business_id(2,100),gen_random_uuid(),1,public.business_id(3,1),'{}',
  array[public.business_id(1,100)],'{}',jsonb_build_object(public.business_id(1,101)::text,public.manual_entitlement(101,101)))$q$,
  'Funding links must identify roster students with UUID strings');
select public.atomic_reject($q$select public.save_session_reservation(public.business_id(2,100),gen_random_uuid(),1,public.business_id(3,1),'{}',
  array[public.business_id(1,100)],jsonb_build_object(public.business_id(1,100)::text,gen_random_uuid()),
  jsonb_build_object(public.business_id(1,100)::text,public.manual_entitlement(100,100)))$q$, 'Ambiguous session funding');
select public.manual_reserve(101,100,100,0,12);
select public.save_session_attendance(public.business_id(2,101),public.business_id(6,501),1,public.business_attendance(100,'present'),false,null);
select public.atomic_assert(remaining_classes=3,'manual provisional presence never consumes') from public.manual_credit_entitlements_with_balance where entitlement_id=public.manual_entitlement(100,100);
select public.save_session_attendance(public.business_id(2,101),public.business_id(6,502),2,public.business_attendance(100,'present'),true,null);
select public.atomic_assert(public.save_session_attendance(public.business_id(2,101),public.business_id(6,502),2,public.business_attendance(100,'present'),true,null)->>'replayed'='true','manual finalization receipt retry consumes once');
select public.atomic_assert(remaining_classes=2,'manual present finalization consumes one') from public.manual_credit_entitlements_with_balance where entitlement_id=public.manual_entitlement(100,100);
select public.save_session_attendance(public.business_id(2,101),gen_random_uuid(),3,public.business_attendance(100,'absent'),true,null);
select public.save_session_attendance(public.business_id(2,101),gen_random_uuid(),4,public.business_attendance(100,'present'),true,null);
select public.atomic_assert(remaining_classes=2,'manual present/absent/present corrections retain one original penalty debit') from public.manual_credit_entitlements_with_balance where entitlement_id=public.manual_entitlement(100,100);
select public.waive_session_penalty(public.business_id(2,101),public.business_id(1,100),public.business_id(6,503),5,'Owner restores original manual credit');
select public.atomic_assert(public.waive_session_penalty(public.business_id(2,101),public.business_id(1,100),public.business_id(6,503),5,'Owner restores original manual credit')->>'replayed'='true','manual waiver retry restores once');
select public.save_session_attendance(public.business_id(2,101),gen_random_uuid(),6,public.business_attendance(100,'absent'),true,null);
select public.atomic_assert(remaining_classes=3,'waived manual penalty is never silently rebilled') from public.manual_credit_entitlements_with_balance where entitlement_id=public.manual_entitlement(100,100);
select public.atomic_assert(public.manual_reserve(101,100,100,0,12)->>'revision'='1','manual reservation replay preserves original receipt after corrections and waiver');
select public.manual_reserve(102,101,101,2,12);
select public.cancel_session_reservation(public.business_id(2,102),public.business_id(1,101),gen_random_uuid(),1,'Manual timely cancellation');
select public.save_session_attendance(public.business_id(2,102),gen_random_uuid(),2,public.business_attendance(101,'pending'),true,null);
select public.atomic_assert(remaining_classes=2,'timely manual cancellation does not consume') from public.manual_credit_entitlements_with_balance where entitlement_id=public.manual_entitlement(101,101);
select public.manual_reserve(103,101,101,-1,12);
select public.cancel_session_reservation(public.business_id(2,103),public.business_id(1,101),gen_random_uuid(),1,'Manual late cancellation');
select public.save_session_attendance(public.business_id(2,103),gen_random_uuid(),2,public.business_attendance(101,'pending'),true,null);
select public.atomic_assert(billing_kind='late_cancellation' and penalty_state='charged','late manual cancellation charged at finalization') from public.session_business_state where session_id=public.business_id(2,103);
select public.atomic_assert(remaining_classes=1,'late manual cancellation consumes exactly one') from public.manual_credit_entitlements_with_balance where entitlement_id=public.manual_entitlement(101,101);
select public.manual_reserve(104,103,103,0,12);
select public.atomic_reject($q$select public.save_session_attendance(public.business_id(2,104),gen_random_uuid(),1,public.business_attendance(103,'present'),true,null)$q$,
  'Presence requires valid original credit%');
select public.atomic_assert(archived_at is not null,'manual approval does not reactivate archived student') from public.students where id=public.business_id(1,103);

-- Depleted original manual incident cannot use a later approved grant. Restore original via its other penalty.
select public.manual_approve(105,105,'new_manual',1,0);
select public.manual_reserve(105,105,105,0,10);
select public.manual_reserve(106,105,105,0,12);
select public.save_session_attendance(public.business_id(2,105),gen_random_uuid(),1,public.business_attendance(105,'absent'),true,null);
select public.save_session_attendance(public.business_id(2,106),gen_random_uuid(),1,public.business_attendance(105,'absent'),true,null);
select public.manual_approve(105,205,'new_manual',4,0);
select public.atomic_reject($q$select public.manual_settle(106,506,2)$q$, 'Original incident source is not usable:%');
select public.atomic_assert(remaining_classes=4,'later manual grant cannot substitute for original pending incident') from public.manual_credit_entitlements_with_balance where entitlement_id=public.manual_entitlement(105,205);
select public.waive_session_penalty(public.business_id(2,105),public.business_id(1,105),gen_random_uuid(),2,'Restore exhausted original entitlement');
reset role;
create table public.manual_pending_before as select id,to_jsonb(p) raw from public.session_business_penalties p where session_id=public.business_id(2,106);
grant select on public.manual_pending_before to authenticated;
set role authenticated;
set request.jwt.claim.sub = '01000000-0000-0000-0000-000000000001';
select public.atomic_reject($q$select public.manual_settle(106,506,2)$q$, 'Only this workshop owner may settle penalties','42501');
set request.jwt.claim.sub = '01000000-0000-0000-0000-000000000003';
select public.atomic_reject($q$select public.manual_settle(106,506,2)$q$, 'Only this workshop owner may settle penalties','42501');
set request.jwt.claim.sub = '00000000-0000-0000-0000-000000000001';
select public.atomic_reject($q$select public.manual_settle(106,506,1)$q$, 'Stale session revision','40001');
select public.atomic_reject($q$select public.manual_settle(106,506,2,' ')$q$, 'Penalty, request key, revision and auditable reason required');
select public.manual_assert_settlement_rollback(106,506,2);
select public.manual_settle(106,506,2);
select public.atomic_assert(public.manual_settle(106,506,2)->>'replayed'='true','manual settlement idempotent before stale revision');
select public.atomic_reject($q$select public.manual_settle(106,506,2,'changed reason')$q$, 'Idempotency key conflicts with original session intent');
select public.atomic_reject($q$select public.manual_settle(106,507,3)$q$, 'Penalty is already settled');
select public.atomic_assert(remaining_classes=0,'settlement consumes only restored original manual source') from public.manual_credit_entitlements_with_balance where entitlement_id=public.manual_entitlement(105,105);
select public.atomic_assert(remaining_classes=4,'alternate grant unchanged after successful settlement') from public.manual_credit_entitlements_with_balance where entitlement_id=public.manual_entitlement(105,205);
select public.atomic_assert(p.state='pending' and to_jsonb(p)=b.raw,'settlement never rewrites immutable pending penalty') from public.session_business_penalties p join public.manual_pending_before b using(id);
select public.atomic_assert(penalty_state='charged' and billing_state='charged' and settlement_id is not null,'business view projects settlement without rewriting original incident')
  from public.session_business_state where session_id=public.business_id(2,106);
select public.atomic_assert(not is_pending and not is_waived and original_penalty_state='pending','profile incident has settlement flags and original pending state')
  from public.session_pending_penalties where session_id=public.business_id(2,106);
select public.save_session_attendance(public.business_id(2,106),gen_random_uuid(),3,public.business_attendance(105,'present'),true,null);
select public.waive_session_penalty(public.business_id(2,106),public.business_id(1,105),public.business_id(6,508),4,'Owner waives settled manual incident');
select public.atomic_assert(public.waive_session_penalty(public.business_id(2,106),public.business_id(1,105),public.business_id(6,508),4,'Owner waives settled manual incident')->>'replayed'='true','post-settlement manual waiver durable retry');
select public.atomic_assert(remaining_classes=1,'owner waiver finds settlement debit and restores original manual source') from public.manual_credit_entitlements_with_balance where entitlement_id=public.manual_entitlement(105,105);
select public.save_session_attendance(public.business_id(2,106),gen_random_uuid(),5,public.business_attendance(105,'absent'),true,null);
select public.atomic_assert(billing_state='waived' and penalty_state='waived' and settlement_id is not null,'waiver wins projection while settlement history remains') from public.session_business_state where session_id=public.business_id(2,106);
select public.atomic_assert(public.manual_settle(106,506,2)->>'revision'='3','delayed settlement replay returns original receipt after waiver');
select public.atomic_reject($q$select public.manual_reserve(106,105,205,0,12)$q$, 'Idempotency key conflicts with original session intent');
set request.jwt.claim.sub = '01000000-0000-0000-0000-000000000001';
select public.atomic_reject($q$select public.manual_settle(106,506,2)$q$, 'Only this workshop owner may settle penalties','42501');
begin;
set local request.jwt.claim.sub = '00000000-0000-0000-0000-000000000001';
set local request.jwt.claim.role = '';
select public.atomic_reject($q$select public.settle_student_penalty((select id from public.manual_pending_before),public.business_id(6,506),2,
  'Owner resolves original-source incident')$q$, 'Only this workshop owner may settle penalties','42501');
select public.atomic_assert(count(*)=0,'missing authenticated claim cannot read settlement receipts') from public.student_penalty_settlements;
rollback;
set request.jwt.claim.sub = '01000000-0000-0000-0000-000000000004';
select public.atomic_reject($q$select public.settle_student_penalty((select id from public.manual_pending_before),public.business_id(6,506),2,
  'Owner resolves original-source incident')$q$, 'Session not accessible','42501');
select public.atomic_assert(count(*)=0,'unlinked reader cannot read settlements') from public.student_penalty_settlements;
select public.atomic_assert(count(*)=0,'unlinked reader cannot read incident view') from public.session_pending_penalties;
set request.jwt.claim.sub = '01000000-0000-0000-0000-000000000005';
select public.atomic_reject($q$select public.settle_student_penalty((select id from public.manual_pending_before),public.business_id(6,506),2,
  'Owner resolves original-source incident')$q$, 'Only this workshop owner may settle penalties','42501');
select public.atomic_assert(count(*)=0,'linked integration cannot read settlement receipts') from public.student_penalty_settlements;
select public.atomic_assert(count(*)=0,'linked integration cannot read incident view') from public.session_pending_penalties;
set request.jwt.claim.sub = '01000000-0000-0000-0000-000000000002';
select public.atomic_reject($q$select public.settle_student_penalty((select id from public.manual_pending_before),public.business_id(6,506),2,
  'Owner resolves original-source incident')$q$, 'Session not accessible','42501');
reset role;
begin;
update public.sedes set owner_id=public.business_id(0,1) where id=public.business_id(3,1);
set local role authenticated;
set local request.jwt.claim.sub = '00000000-0000-0000-0000-000000000001';
select public.atomic_reject($q$select public.manual_settle(106,506,2)$q$, 'Session not accessible','42501');
rollback;
set role authenticated;
set request.jwt.claim.sub = '00000000-0000-0000-0000-000000000001';

-- Real unlinked SuperAdmin gets global reads, not financial write or replay rights.
reset role;
begin;
delete from public.sede_members where user_id=public.business_id(0,3);
set local role authenticated;
set local request.jwt.claim.sub = '01000000-0000-0000-0000-000000000003';
select public.atomic_assert(count(*)=4,'unlinked real SuperAdmin reads all initial manual entitlements globally')
  from public.student_manual_credit_entitlements where student_id in
    (public.business_id(1,100),public.business_id(1,101),public.business_id(1,102),public.business_id(1,103));
select public.atomic_assert(count(*)=1,'unlinked real SuperAdmin reads manual settlement globally')
  from public.student_penalty_settlements where session_id=public.business_id(2,106);
select public.atomic_assert(not can_approve_manual_credit and not can_reconcile_legacy and jsonb_array_length(penalty_incidents)>0,
  'global read projection exposes history without financial capabilities')
  from public.student_credit_profile where student_id=public.business_id(1,105);
select public.atomic_reject($q$select public.manual_approve(100,100,'reconcile_legacy',3,3)$q$, 'Only this workshop owner may approve manual credits','42501');
select public.atomic_reject($q$select public.manual_settle(106,506,2)$q$, 'Only this workshop owner may settle penalties','42501');
rollback;
set role authenticated;

-- A genuine allowlisted read-only API principal still gets no finance capability.
reset role;
begin;
insert into private.domain_read_principals(user_id,kind,enabled,expires_at)
  values(public.business_id(0,4),'integration',true,now()+interval '1 day');
insert into private.domain_read_grants(user_id,sede_id,student_id,operation,enabled,expires_at)
  values(public.business_id(0,4),public.business_id(3,1),public.business_id(1,100),'student.summary.get',true,now()+interval '1 day');
set local role authenticated;
set local request.jwt.claim.sub = '01000000-0000-0000-0000-000000000004';
select public.atomic_assert(public.domain_read_v1(jsonb_build_object('version',1,'operation','student.summary.get',
  'sedeId',public.business_id(3,1),'studentId',public.business_id(1,100)))->'data'->>'studentId'=public.business_id(1,100)::text,
  'explicitly scoped reader can use only its allowlisted summary API');
select public.atomic_reject($q$select public.manual_approve(100,100,'reconcile_legacy',3,3)$q$, 'Only this workshop owner may approve manual credits','42501');
select public.atomic_reject($q$select public.settle_student_penalty((select id from public.manual_pending_before),public.business_id(6,506),2,
  'Owner resolves original-source incident')$q$, 'Session not accessible','42501');
select public.atomic_assert(count(*)=0,'allowlisted reader cannot read full financial profiles') from public.student_credit_profile;
select public.atomic_assert(count(*)=0,'allowlisted reader cannot read settlement audit rows') from public.student_penalty_settlements;
rollback;
set role authenticated;

-- Unknown original IDs cannot be manufactured by approving/reconciling new manual credit.
select public.business_reserve(107,106,0,12);
select public.save_session_attendance(public.business_id(2,107),gen_random_uuid(),1,public.business_attendance(106,'absent'),true,null);
select public.manual_approve(106,106,'new_manual',2,0);
select public.atomic_reject($q$select public.manual_settle(107,509,2)$q$, 'Only the known original incident source may settle');
select public.atomic_reject($q$select public.save_session_reservation(public.business_id(2,107),gen_random_uuid(),2,public.business_id(3,1),'{}',
  array[public.business_id(1,106)],'{}',jsonb_build_object(public.business_id(1,106)::text,public.manual_entitlement(106,106)))$q$, 'Finalized roster and original funding are locked');

-- Mixed transaction must roll back a valid first manual debit when second student fails.
select public.manual_approve(107,107,'new_manual',1,0);
select public.save_session_reservation(public.business_id(2,108),gen_random_uuid(),0,public.business_id(3,1),public.business_metadata(1,12),
  array[public.business_id(1,107),public.business_id(1,108)],'{}',jsonb_build_object(public.business_id(1,107)::text,public.manual_entitlement(107,107)));
select public.atomic_reject(format($q$select public.save_session_attendance(public.business_id(2,108),gen_random_uuid(),1,%L::jsonb,true,null)$q$,
  public.business_attendance(107,'present')||public.business_attendance(108,'present')), 'Presence requires valid original credit%');
select public.atomic_assert(remaining_classes=1,'mixed rollback restores manual ledger') from public.manual_credit_entitlements_with_balance where entitlement_id=public.manual_entitlement(107,107);
select public.atomic_assert(count(*)=0,'mixed rollback creates no manual debit or partial billing') from public.session_credit_movements where session_id=public.business_id(2,108);
select public.atomic_assert(revision=1 and completed_at is null,'mixed rollback preserves session revision') from public.sessions where id=public.business_id(2,108);

-- Existing original membership can settle only if paid, current, valid and known positive.
select public.atomic_reject($q$select public.manual_settle(10,510,3)$q$, 'Original incident source is not usable:%');
select public.atomic_reject($q$select public.manual_settle(19,510,3)$q$, 'Penalty is already waived');
select public.atomic_reject($q$select public.manual_settle(54,510,2)$q$, 'Only the known original incident source may settle');
select public.manual_assert_settlement_rollback(7,510,3);
select public.manual_settle(7,510,3);
select public.atomic_assert(classes_remaining=3,'original valid membership settlement consumes one without rollover') from public.students where id=public.business_id(1,7);
select public.waive_session_penalty(public.business_id(2,7),public.business_id(1,7),gen_random_uuid(),4,'Owner waives settled membership');
select public.atomic_assert(classes_remaining=4,'settled membership waiver restores only original debit') from public.students where id=public.business_id(1,7);
reset role;
update public.students set classes_remaining=1 where id=public.business_id(1,6);
set role authenticated;
select public.manual_settle(6,517,4);
select public.atomic_assert(classes_remaining=0,'pending penalty created by attendance correction can settle original period despite earlier billing revision') from public.students where id=public.business_id(1,6);
select public.atomic_assert(finalized_revision=3 and settlement_revision=5,'settlement retains original first-finalization revision and records new resolution revision')
  from public.session_business_state where session_id=public.business_id(2,6);
select public.business_reserve(109,17,0,12);
reset role;
update public.students set classes_remaining=0 where id=public.business_id(1,17);
set role authenticated;
select public.save_session_attendance(public.business_id(2,109),gen_random_uuid(),1,public.business_attendance(17,'absent'),true,null);
select public.atomic_reject($q$select public.manual_settle(109,511,2)$q$, 'Original incident source is not usable:%');
reset role;
update public.student_membership_periods set starts_on=private.membership_today()-30,ends_on=private.membership_today()-1 where student_id=public.business_id(1,17);
set role authenticated;
select public.schedule_student_membership(public.business_id(1,17),gen_random_uuid(),'platinum',8);
select public.confirm_student_membership_payment(current_membership_period_id) from public.students where id=public.business_id(1,17);
select public.atomic_reject($q$select public.manual_settle(109,511,2)$q$, 'Original incident source is not usable:%');
select public.atomic_assert(classes_remaining=8,'later paid membership cannot substitute for pending original period') from public.students where id=public.business_id(1,17);

-- A depleted original gift is restored by its charged penalty, not substituted by another valid card.
insert into public.gift_cards(id,sede_id,recipient,recipient_student_id,num_classes,type,activated_at,validity_months,payment_status)
  values (public.business_id(4,100),public.business_id(3,1),'Manual Student 109',public.business_id(1,109),1,'modelado',private.membership_today(),3,'paid'),
    (public.business_id(4,101),public.business_id(3,1),'Manual Student 109',public.business_id(1,109),2,'modelado',private.membership_today(),3,'paid');
select public.business_reserve(110,109,0,10,100);
select public.business_reserve(111,109,0,12,100);
select public.save_session_attendance(public.business_id(2,110),gen_random_uuid(),1,public.business_attendance(109,'absent'),true,null);
select public.save_session_attendance(public.business_id(2,111),gen_random_uuid(),1,public.business_attendance(109,'absent'),true,null);
select public.atomic_reject($q$select public.manual_settle(111,512,2)$q$, 'Original incident source is not usable:%');
select public.atomic_assert(sessions_used=0,'alternate valid gift cannot substitute') from public.gift_cards where id=public.business_id(4,101);
select public.waive_session_penalty(public.business_id(2,110),public.business_id(1,109),gen_random_uuid(),2,'Restore original card');
select public.manual_assert_settlement_rollback(111,512,2);
select public.manual_settle(111,512,2);
select public.atomic_assert(sessions_used=1,'gift settlement consumes original through existing gift ledger') from public.gift_cards where id=public.business_id(4,100);
select public.waive_session_penalty(public.business_id(2,111),public.business_id(1,109),gen_random_uuid(),3,'Owner waives settled gift');
select public.atomic_assert(sessions_used=0,'settled gift waiver reverses original shared ledger') from public.gift_cards where id=public.business_id(4,100);

select public.save_session_reservation(public.business_id(2,130),gen_random_uuid(),0,public.business_id(3,1),public.business_metadata(6,10,4),
  array[public.business_id(1,17),public.business_id(1,107),public.business_id(1,109),public.business_id(1,160)],
  jsonb_build_object(public.business_id(1,109)::text,public.business_id(4,101)),
  jsonb_build_object(public.business_id(1,107)::text,public.manual_entitlement(107,107)));
select public.atomic_reject(format($q$select public.save_session_attendance(public.business_id(2,130),gen_random_uuid(),1,%L::jsonb,true,null)$q$,
  public.business_attendance(17,'present')||public.business_attendance(107,'present')||public.business_attendance(109,'present')||public.business_attendance(160,'present')),
  'Presence requires valid original credit%');
select public.atomic_assert(classes_remaining=8,'four-student mixed rollback restores original membership adjustment') from public.students where id=public.business_id(1,17);
select public.atomic_assert(remaining_classes=1,'four-student mixed rollback restores manual ledger') from public.manual_credit_entitlements_with_balance where entitlement_id=public.manual_entitlement(107,107);
select public.atomic_assert(sessions_used=0,'four-student mixed rollback restores original gift ledger') from public.gift_cards where id=public.business_id(4,101);
select public.atomic_assert(not exists(select 1 from public.session_credit_movements where session_id=public.business_id(2,130))
  and not exists(select 1 from public.gift_card_operation_receipts where session_id=public.business_id(2,130))
  and not exists(select 1 from public.session_business_billing where session_id=public.business_id(2,130)), 'mixed three-source failure leaves no financial receipts or billing');

-- Unknown original payment requires an actual confirmation, never manual approval.
reset role;
update public.student_membership_periods set payment_status=null where student_id=public.business_id(1,18);
set role authenticated;
select public.business_reserve(131,18,6,12);
select public.save_session_attendance(public.business_id(2,131),gen_random_uuid(),1,public.business_attendance(18,'absent'),true,null);
select public.atomic_reject($q$select public.manual_settle(131,516,2)$q$, 'Original incident source is not usable:%');
select public.manual_approve(18,218,'new_manual',1,4);
select public.atomic_reject($q$select public.manual_settle(131,516,2)$q$, 'Original incident source is not usable:%');
select public.atomic_assert(classes_remaining=4 and (select payment_status from public.student_membership_periods where id=st.current_membership_period_id) is null,
  'deliberate manual grant to member neither duplicates scalar allocation nor confirms original payment') from public.students st where id=public.business_id(1,18);
select public.confirm_student_membership_payment(current_membership_period_id) from public.students where id=public.business_id(1,18);
select public.manual_settle(131,516,2);
select public.atomic_assert(classes_remaining=3,'actual original payment confirmation permits original-source settlement') from public.students where id=public.business_id(1,18);
select public.atomic_assert(remaining_classes=1,'original membership settlement ignores separately approved manual source') from public.manual_credit_entitlements_with_balance where entitlement_id=public.manual_entitlement(18,218);
reset role;
update public.student_membership_periods set starts_on=private.membership_today()-30,ends_on=private.membership_today()-1
  where student_id=public.business_id(1,18);
set role authenticated;
select public.schedule_student_membership(public.business_id(1,18),gen_random_uuid(),'platinum',8);
reset role;
create table public.manual_outgoing_before as select id,outgoing_snapshot from public.student_membership_periods where student_id=public.business_id(1,18);
grant select on public.manual_outgoing_before to authenticated;
set role authenticated;
select public.waive_session_penalty(public.business_id(2,131),public.business_id(1,18),gen_random_uuid(),3,'Owner waives settlement after actual rollover');
select public.atomic_assert(classes_remaining=8,'settled historical membership waiver never credits successor') from public.students where id=public.business_id(1,18);
select public.atomic_assert(not exists(select 1 from public.manual_outgoing_before b join public.student_membership_periods p using(id)
  where b.outgoing_snapshot is distinct from p.outgoing_snapshot), 'settled membership historical reversal preserves outgoing snapshots');

select public.manual_approve(113,113,'new_manual',2,0);
set request.jwt.claim.sub = '01000000-0000-0000-0000-000000000001';
select public.manual_reserve(132,113,113,3,12);
select public.save_session_attendance(public.business_id(2,132),gen_random_uuid(),1,public.business_attendance(113,'present'),false,null);
select public.save_session_attendance(public.business_id(2,132),gen_random_uuid(),2,public.business_attendance(113,'present'),true,null);
select public.save_session_attendance(public.business_id(2,132),gen_random_uuid(),3,public.business_attendance(113,'absent'),true,null);
select public.atomic_reject($q$select public.waive_session_penalty(public.business_id(2,132),public.business_id(1,113),gen_random_uuid(),4,'Staff cannot waive manual charge')$q$,
  'Only this workshop owner may waive penalties','42501');
select public.atomic_assert(created_by=auth.uid() and manual_credit_id=public.manual_entitlement(113,113),'authorized employee can operate owner-approved manual funding; actual movement actor retained')
  from public.session_credit_movements where session_id=public.business_id(2,132);
set request.jwt.claim.sub = '00000000-0000-0000-0000-000000000001';
select public.waive_session_penalty(public.business_id(2,132),public.business_id(1,113),gen_random_uuid(),4,'Actual owner waives employee-recorded manual penalty');

insert into public.gift_cards(id,sede_id,recipient,recipient_student_id,num_classes,type,activated_at,validity_months,payment_status)
  values (public.business_id(4,103),public.business_id(3,1),'Manual Student 114',public.business_id(1,114),2,'modelado',private.membership_today(),3,'pending'),
    (public.business_id(4,104),public.business_id(3,1),'Manual Student 115',public.business_id(1,115),2,'modelado',private.membership_today()+2,3,'pending');
select public.business_reserve(133,114,2,12,103);
select public.save_session_attendance(public.business_id(2,133),gen_random_uuid(),1,public.business_attendance(114,'absent'),true,null);
select public.confirm_gift_card_payment(public.business_id(4,103));
reset role;
begin;
-- Synthetic inconsistent old ledger: the owner-only private helper is used only inside this disposable test transaction.
select private.apply_gift_card_session(public.business_id(4,103),public.business_id(2,133),public.business_id(1,114),false,gen_random_uuid());
set local role authenticated;
select public.atomic_reject($q$select public.manual_settle(133,518,2)$q$, 'Pending incident gift ledger requires reconciliation');
select public.atomic_assert(sessions_used=1,'rejected inconsistent gift settlement does not mutate existing source balance') from public.gift_cards where id=public.business_id(4,103);
rollback;
set role authenticated;
select public.manual_settle(133,518,2);
select public.atomic_assert(sessions_used=1,'consistent original gift incident settles normally') from public.gift_cards where id=public.business_id(4,103);
select public.business_reserve(134,115,3,12,104);
select public.confirm_gift_card_payment(public.business_id(4,104));
select public.atomic_reject($q$select public.save_session_attendance(public.business_id(2,134),gen_random_uuid(),1,public.business_attendance(115,'present'),true,null)$q$,
  'Presence requires valid original credit%');
select public.atomic_reject($q$select public.approve_session_exception(public.business_id(2,134),public.business_id(1,115),gen_random_uuid(),1,'no_credit','Paid future allocation cannot be bypassed')$q$,
  'No-credit exception cannot bypass available credit%');
select public.atomic_assert(revision=1 and completed_at is null,'paid future activation rejects presence without partial completion/revision') from public.sessions where id=public.business_id(2,134);
select public.save_session_attendance(public.business_id(2,134),gen_random_uuid(),1,public.business_attendance(115,'absent'),true,null);
select public.atomic_assert(is_pending and original_gift_card_id=public.business_id(4,104),'paid future activation no-show stays pending even when activation covers future session date')
  from public.session_pending_penalties where session_id=public.business_id(2,134);
select public.business_reserve(172,115,-1,12,104);
select public.cancel_session_reservation(public.business_id(2,172),public.business_id(1,115),gen_random_uuid(),1,'Paid future gift late cancellation');
select public.save_session_attendance(public.business_id(2,172),gen_random_uuid(),2,public.business_attendance(115,'pending'),true,null);
select public.atomic_assert(is_pending and kind='late_cancellation' and original_gift_card_id=public.business_id(4,104),
  'actual late cancellation with paid future activation records a pending original-source incident') from public.session_pending_penalties where session_id=public.business_id(2,172);
select public.business_reserve(174,115,0,14);
select public.atomic_reject($q$select public.approve_session_exception(public.business_id(2,174),public.business_id(1,115),gen_random_uuid(),1,'no_credit','Unselected paid future gift is still a known allocation')$q$,
  'No-credit exception cannot bypass available credit%');
select public.atomic_assert(not exists(select 1 from public.gift_card_movements where gift_card_id=public.business_id(4,104))
  and not exists(select 1 from public.gift_card_operation_receipts where gift_card_id=public.business_id(4,104))
  and not exists(select 1 from public.session_credit_movements where session_id in(public.business_id(2,134),public.business_id(2,172))),
  'paid future present/no-show/late/courtesy attempts create no gift movements, gift receipts or credit debits');
select public.atomic_reject($q$select public.manual_settle(134,519,2)$q$, 'Original incident source is not usable:%');
select public.atomic_assert(sessions_used=0,'original gift with future activation cannot settle early even after explicit payment') from public.gift_cards where id=public.business_id(4,104);
select public.business_reserve(175,114,3,12,103);
select public.save_session_attendance(public.business_id(2,175),gen_random_uuid(),1,public.business_attendance(114,'present'),true,null);
select public.atomic_assert(billing_state='charged' and funding_gift_card_id=public.business_id(4,103),
  'paid gift activated today remains valid for a covered future session') from public.session_business_state where session_id=public.business_id(2,175);

-- Expiry, future activation and activity are immutable entitlement terms, not owner bypasses.
select public.approve_student_manual_credit(public.business_id(1,110),public.business_id(6,110),'new_manual',2,0,'mesa',
  private.membership_today()-60,private.membership_today()-30,'Expired entitlement evidence','Signed expired grant');
select public.manual_reserve(112,110,110,0,12);
select public.save_session_attendance(public.business_id(2,112),gen_random_uuid(),1,public.business_attendance(110,'absent'),true,null);
select public.atomic_reject($q$select public.manual_settle(112,513,2)$q$, 'Original incident source is not usable:%');
select public.approve_student_manual_credit(public.business_id(1,111),public.business_id(6,111),'new_manual',2,0,'mesa',
  private.membership_today()+1,private.membership_today()+60,'Future entitlement evidence','Signed future grant');
select public.manual_reserve(113,111,111,1,12);
select public.save_session_attendance(public.business_id(2,113),gen_random_uuid(),1,public.business_attendance(111,'absent'),true,null);
select public.atomic_reject($q$select public.manual_settle(113,514,2)$q$, 'Original incident source is not usable:%');
select public.approve_student_manual_credit(public.business_id(1,112),public.business_id(6,112),'new_manual',2,0,'torno',
  private.membership_today()-1,private.membership_today()+60,'Torno-only entitlement','Signed torno grant');
select public.manual_reserve(114,112,112,0,12);
select public.save_session_attendance(public.business_id(2,114),gen_random_uuid(),1,public.business_attendance(112,'absent'),true,null);
select public.atomic_reject($q$select public.manual_settle(114,515,2)$q$, 'Original incident source is not usable:%');
select public.atomic_assert(bool_and(remaining_classes=2),'unusable original manual sources remain financially unchanged')
  from public.manual_credit_entitlements_with_balance where student_id in(public.business_id(1,110),public.business_id(1,111),public.business_id(1,112));

-- A reconciled observation is not a second allocation after its ledger reaches zero.
select public.manual_approve(116,116,'reconcile_legacy',1,1);
select public.manual_reserve(115,116,116,4,12);
select public.save_session_attendance(public.business_id(2,115),gen_random_uuid(),1,public.business_attendance(116,'absent'),true,null);
select public.manual_reserve(116,116,116,4,14);
select public.approve_session_exception(public.business_id(2,116),public.business_id(1,116),gen_random_uuid(),1,'no_credit','Known exhausted manual courtesy');
select public.save_session_attendance(public.business_id(2,116),gen_random_uuid(),2,public.business_attendance(116,'present'),true,null);
select public.atomic_assert(billing_kind='courtesy' and billing_state='no_charge','known depleted reconciled ledger allows explicit courtesy without reusing scalar')
  from public.session_business_state where session_id=public.business_id(2,116);
insert into public.gift_cards(id,sede_id,recipient,recipient_student_id,num_classes,type,activated_at,validity_months,payment_status)
  values (public.business_id(4,102),public.business_id(3,1),'Manual Student 101',public.business_id(1,101),1,'modelado',private.membership_today(),3,'paid');
select public.business_reserve(117,101,4,16);
select public.atomic_reject($q$select public.approve_session_exception(public.business_id(2,117),public.business_id(1,101),gen_random_uuid(),1,'no_credit','Reconciled does not bypass gift')$q$,
  'No-credit exception cannot bypass available credit%');
select public.manual_reserve(118,102,102,4,12);
select public.save_session_attendance(public.business_id(2,118),gen_random_uuid(),1,public.business_attendance(102,'absent'),true,null);
select public.manual_reserve(119,102,102,4,14);
select public.atomic_reject($q$select public.approve_session_exception(public.business_id(2,119),public.business_id(1,102),gen_random_uuid(),1,'no_credit','New grant does not reconcile old observation')$q$,
  'No-credit exception cannot bypass available credit%');
select public.manual_reserve(135,101,101,5,14);
select public.save_session_attendance(public.business_id(2,135),gen_random_uuid(),1,public.business_attendance(101,'absent'),true,null);
select public.manual_reserve(136,101,101,5,16);
select public.atomic_reject($q$select public.approve_session_exception(public.business_id(2,136),public.business_id(1,101),gen_random_uuid(),1,'no_credit','Unknown legacy cannot become zero after new grant depletion')$q$,
  'No-credit exception cannot bypass available credit%');
select public.atomic_assert(legacy_observed_balance is null and not can_reconcile_legacy,
  'depleted independent new_manual never resolves or initializes unknown legacy funds')
  from public.student_credit_profile where student_id=public.business_id(1,101);

-- Cancellation locks the source BEFORE an incident is finalized, not just afterwards.
select public.manual_approve(117,117,'new_manual',2,0);
select public.manual_reserve(137,117,117,-1,14);
select public.cancel_session_reservation(public.business_id(2,137),public.business_id(1,117),gen_random_uuid(),1,'Original manual source locked on cancellation');
select public.manual_approve(117,217,'new_manual',2,0);
select public.atomic_reject($q$select public.save_session_reservation(public.business_id(2,137),gen_random_uuid(),2,public.business_id(3,1),'{}',
  array[public.business_id(1,117)],'{}',jsonb_build_object(public.business_id(1,117)::text,public.manual_entitlement(117,217)))$q$,
  'Cancellation and its original funding are immutable');
select public.save_session_attendance(public.business_id(2,137),gen_random_uuid(),2,public.business_attendance(117,'pending'),true,null);
select public.atomic_assert(original_manual_credit_id=public.manual_entitlement(117,117) and original_penalty_state='charged',
  'late cancellation incident records only source locked before incident') from public.session_pending_penalties where session_id=public.business_id(2,137);
select public.business_reserve(138,118,-1,14);
select public.cancel_session_reservation(public.business_id(2,138),public.business_id(1,118),gen_random_uuid(),1,'Missing original source cancellation');
select public.manual_approve(118,118,'new_manual',2,0);
select public.atomic_reject($q$select public.save_session_reservation(public.business_id(2,138),gen_random_uuid(),2,public.business_id(3,1),'{}',
  array[public.business_id(1,118)],'{}',jsonb_build_object(public.business_id(1,118)::text,public.manual_entitlement(118,118)))$q$,
  'Cancellation and its original funding are immutable');
select public.save_session_attendance(public.business_id(2,138),gen_random_uuid(),2,public.business_attendance(118,'pending'),true,null);
select public.atomic_reject($q$select public.manual_settle(138,538,3)$q$, 'Only the known original incident source may settle');
select public.atomic_assert(original_manual_credit_id is null and is_pending,'old missing-source cancellation cannot be rebound or settled with new manual evidence')
  from public.session_pending_penalties where session_id=public.business_id(2,138);

-- ACLs and append-only terms cannot be bypassed by authenticated or BYPASSRLS service role.
select public.atomic_reject($q$update public.student_manual_credit_entitlements set quantity=99$q$, 'permission denied%','42501');
select public.atomic_reject($q$delete from public.student_penalty_settlements$q$, 'permission denied%','42501');
select public.atomic_reject($q$update public.session_credit_movements set manual_credit_id=null$q$, 'permission denied%','42501');
select public.atomic_reject($q$select private.save_session_reservation_before_manual(public.business_id(2,100),gen_random_uuid(),1,
  public.business_id(3,1),'{}',array[public.business_id(1,100)],'{}')$q$, 'permission denied%','42501');
select public.atomic_reject($q$select private.session_business_action_before_manual(public.business_id(2,106),public.business_id(1,105),gen_random_uuid(),6,'waive_session_penalty',null,'bypass')$q$,
  'permission denied%','42501');
reset role;
select public.atomic_reject($q$update public.student_manual_credit_entitlements set evidence='rewrite'$q$, 'Session history is append-only','42501');
select public.atomic_reject($q$delete from public.student_penalty_settlements$q$, 'Session history is append-only','42501');
select public.atomic_reject($q$update public.session_students set manual_credit_id=public.manual_entitlement(101,101)
  where session_id=public.business_id(2,100)$q$, '%session_manual_owner_fk%','23503');
select public.atomic_reject($q$update public.session_students set manual_credit_id=public.manual_entitlement(105,205)
  where session_id=public.business_id(2,106)$q$, 'Original manual funding is immutable after cancellation or finalization');
select public.atomic_reject($q$insert into public.session_credit_movements(session_id,student_id,sede_id,revision,manual_credit_id,
  delta,disposition,created_by) values(public.business_id(2,101),public.business_id(1,100),public.business_id(3,1),8,
  public.manual_entitlement(100,100),-1,'manual_credit',auth.uid())$q$, '%session_credit_manual_consumption_once%','23505');
select public.atomic_reject($q$insert into public.session_credit_movements(session_id,student_id,sede_id,revision,manual_credit_id,
  delta,reverses_id,disposition,created_by) values(public.business_id(2,106),public.business_id(1,105),public.business_id(3,1),8,
  public.manual_entitlement(105,105),1,(select id from public.session_credit_movements where session_id=public.business_id(2,101) and delta=-1),
  'manual_credit',auth.uid())$q$, 'Manual reversal must reference its exact original debit');
set role service_role;
select public.atomic_reject($q$select public.manual_approve(100,100,'reconcile_legacy',3,3)$q$, 'permission denied%','42501');
select public.atomic_reject($q$select public.manual_settle(106,506,2)$q$, 'permission denied%','42501');
select public.atomic_reject($q$update public.student_manual_credit_entitlements set quantity=99$q$, 'permission denied%','42501');
select public.atomic_reject($q$insert into public.student_penalty_settlements default values$q$, 'permission denied%','42501');
reset role;
select public.atomic_assert(not has_function_privilege('anon','public.approve_student_manual_credit(uuid,uuid,text,integer,integer,text,date,date,text,text)','execute')
  and not has_table_privilege('service_role','public.student_credit_profile','select'), 'no anonymous or service financial/read endpoint grants');
select public.atomic_assert(bool_and(to_jsonb(st)=b.raw),'all temporal raw student state survives manual consumption, settlement and waivers')
  from public.students st join public.manual_students_before b using(id);
select public.atomic_assert(not exists(select 1 from public.session_credit_movements where num_nonnulls(period_id,gift_card_id,manual_credit_id)<>1), 'all movement receipts have one exclusive financial source');
select public.atomic_assert(not exists(select 1 from public.manual_preservation_before b where b.kind in
  ('receipts','credits','gift_movements','gift_receipts','adjustments','penalties','exceptions','events','waivers') and not exists (
    select 1 from (
      select 'receipts' kind,to_jsonb(t) raw from public.session_operation_receipts t
      union all select 'credits',to_jsonb(t)-'manual_credit_id' from public.session_credit_movements t
      union all select 'gift_movements',to_jsonb(t) from public.gift_card_movements t
      union all select 'gift_receipts',to_jsonb(t) from public.gift_card_operation_receipts t
      union all select 'adjustments',to_jsonb(t) from public.student_membership_class_adjustments t
      union all select 'penalties',to_jsonb(t)-'manual_credit_id' from public.session_business_penalties t
      union all select 'exceptions',to_jsonb(t)-'manual_credit_id' from public.session_business_exceptions t
      union all select 'events',to_jsonb(t) from public.session_business_events t
      union all select 'waivers',to_jsonb(t) from public.session_business_waivers t
    ) history where history.kind=b.kind and history.raw=b.raw)),
  'every pre-manual historical receipt, ledger movement, incident, evidence and audit ID survives all tests unchanged');

-- Socket-only concurrent scenarios use these distinct students and sessions.
set role authenticated;
select public.manual_approve(120,120,'new_manual',1,0);
select public.manual_reserve(120,120,120,10,10);
select public.manual_reserve(121,120,120,10,12);
select public.manual_approve(121,121,'new_manual',2,0);
select public.manual_reserve(122,121,121,11,10);
select public.manual_approve(122,122,'new_manual',1,0);
select public.manual_reserve(123,122,122,12,10);
select public.manual_reserve(124,122,122,12,12);
select public.save_session_attendance(public.business_id(2,123),gen_random_uuid(),1,public.business_attendance(122,'absent'),true,null);
select public.save_session_attendance(public.business_id(2,124),gen_random_uuid(),1,public.business_attendance(122,'absent'),true,null);
select public.waive_session_penalty(public.business_id(2,123),public.business_id(1,122),gen_random_uuid(),2,'Restore for settlement race');
select public.manual_approve(123,123,'new_manual',1,0);
select public.manual_reserve(125,123,123,13,10);
select public.manual_reserve(126,123,123,13,12);
select public.save_session_attendance(public.business_id(2,125),gen_random_uuid(),1,public.business_attendance(123,'absent'),true,null);
select public.save_session_attendance(public.business_id(2,126),gen_random_uuid(),1,public.business_attendance(123,'absent'),true,null);
select public.waive_session_penalty(public.business_id(2,125),public.business_id(1,123),gen_random_uuid(),2,'Restore for distinct-key race');
select public.manual_approve(124,124,'new_manual',1,0);
select public.manual_reserve(127,124,124,14,10);
select public.manual_reserve(128,124,124,14,12);
select public.manual_reserve(129,124,124,14,14);
select public.save_session_attendance(public.business_id(2,127),gen_random_uuid(),1,public.business_attendance(124,'absent'),true,null);
select public.save_session_attendance(public.business_id(2,128),gen_random_uuid(),1,public.business_attendance(124,'absent'),true,null);
select public.save_session_attendance(public.business_id(2,129),gen_random_uuid(),1,public.business_attendance(124,'absent'),true,null);
select public.waive_session_penalty(public.business_id(2,127),public.business_id(1,124),gen_random_uuid(),2,'Restore one class for two incidents');
reset role;
update public.students set classes_remaining=3 where id=public.business_id(1,125);
set role authenticated;
select public.manual_approve(126,126,'new_manual',1,0);
select public.manual_reserve(139,126,126,15,10);
select public.manual_reserve(140,126,126,15,12);
select public.save_session_attendance(public.business_id(2,139),gen_random_uuid(),1,public.business_attendance(126,'absent'),true,null);
select public.save_session_attendance(public.business_id(2,140),gen_random_uuid(),1,public.business_attendance(126,'absent'),true,null);
select public.waive_session_penalty(public.business_id(2,139),public.business_id(1,126),gen_random_uuid(),2,'Restore original for waiver-settlement race');
select public.manual_approve(128,128,'new_manual',1,0);
select public.manual_reserve(141,128,128,16,10);
select public.manual_reserve(142,128,128,16,12);
select public.save_session_attendance(public.business_id(2,141),gen_random_uuid(),1,public.business_attendance(128,'absent'),true,null);
select public.save_session_attendance(public.business_id(2,142),gen_random_uuid(),1,public.business_attendance(128,'absent'),true,null);
select public.waive_session_penalty(public.business_id(2,141),public.business_id(1,128),gen_random_uuid(),2,'Restore source for owner revocation while waiting');
select public.manual_approve(129,129,'new_manual',2,0);
select public.manual_reserve(143,129,129,17,10);
reset role;
\o
\endif
\o
