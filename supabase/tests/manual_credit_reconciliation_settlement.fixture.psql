\set ON_ERROR_STOP on
\o /dev/null
\if :{?manual_legacy_seed}
-- Loaded by the cold-chain runner BEFORE gift integrity, with the real old trigger active.
insert into auth.users(id,email) values('09000000-0000-0000-0000-000000000001','legacy-manual-owner@example.invalid');
insert into public.profiles(id,email,role) values('09000000-0000-0000-0000-000000000001','legacy-manual-owner@example.invalid','tallerista');
insert into public.sedes(id,name,slug,owner_id) values
  ('39000000-0000-0000-0000-000000000001','Legacy mirror tests','manual-legacy-mirrors','09000000-0000-0000-0000-000000000001');
create table public.manual_legacy_gift_cases as
  select n, ('49000000-0000-0000-0000-'||lpad(n::text,12,'0'))::uuid gift_id,
    null::uuid student_id from generate_series(1,12) n where n<>10;
insert into public.gift_cards(id,sede_id,recipient,num_classes,type,activated_at,expiry_date,payment_status,status,sessions_used)
  select gift_id,'39000000-0000-0000-0000-000000000001','LegacyMirror'||n||' Person',4,'modelado',private.membership_today()-10,
    case when n=5 then private.membership_today()-1 else private.membership_today()+60 end,'paid',
    case n when 3 then 'exhausted' when 4 then 'cancelled' when 5 then 'expired' when 11 then 'consumed' else 'active' end,
    case n when 2 then 2 when 3 then 4 when 4 then 1 when 5 then 1 when 11 then 4 else 0 end
  from public.manual_legacy_gift_cases;
update public.manual_legacy_gift_cases c set student_id=g.recipient_student_id from public.gift_cards g where g.id=c.gift_id;
-- These are the trigger-created people, not synthetic scalar copies.
do $$ begin
  if exists(select 1 from public.manual_legacy_gift_cases c left join public.students st on st.id=c.student_id
    where st.id is null or st.classes_remaining<>4 or st.student_category<>'temporal'
      or st.notes not like 'Creado automaticamente%') then raise exception 'Real pre-integrity gift trigger did not create scalar mirrors'; end if;
  raise notice 'PASS: real pre-integrity gift trigger creates eleven stale positive scalar mirrors';
end $$;
insert into public.students(id,sede_id,full_name,name,student_category,classes_remaining)
  values('19000000-0000-0000-0000-000000000012','39000000-0000-0000-0000-000000000001','Pre-rollout Reassignment Target','Pre-rollout Target','temporal',0);
-- Genuine old reassignment: A's scalar survives, the current ID is B, and the label still names A.
update public.gift_cards set recipient_student_id='19000000-0000-0000-0000-000000000012'
  where id='49000000-0000-0000-0000-000000000012';
update public.students st set email='legacy-'||c.n||'@example.invalid' from public.manual_legacy_gift_cases c where st.id=c.student_id and c.n in(8,9);
update public.gift_cards g set recipient=case c.n
  when 6 then '  '||lower(replace(g.recipient,' ',E'\t  '))||'  '
  when 7 then lower(split_part(g.recipient,' ',1))
  when 8 then 'Unrelated display name'
  when 9 then ' LEGACY-9@EXAMPLE.INVALID ' else g.recipient end,
  recipient_email=case when c.n=8 then ' LEGACY-8@EXAMPLE.INVALID ' else g.recipient_email end
  from public.manual_legacy_gift_cases c where g.id=c.gift_id and c.n in(6,7,8,9);
-- Old trigger explicitly preserves an unchanged recipient when its FK is cleared.
update public.gift_cards g set recipient_student_id=null from public.manual_legacy_gift_cases c where g.id=c.gift_id and c.n in(6,7,8,9);
create table public.manual_legacy_gift_before as select g.id,to_jsonb(g) raw from public.gift_cards g join public.manual_legacy_gift_cases c on c.gift_id=g.id;
create table public.manual_legacy_student_before as select st.id,to_jsonb(st) raw from public.students st join public.manual_legacy_gift_cases c on c.student_id=st.id;
insert into public.gift_cards(id,sede_id,recipient,num_classes,type,activated_at,expiry_date,payment_status,status)
  values('49000000-0000-0000-0000-000000000010','39000000-0000-0000-0000-000000000001','LegacyUnknownActivation Person',4,
    'modelado',null,private.membership_today()+60,'paid','active');
create table public.manual_legacy_null_before as select g.id,g.recipient_student_id student_id,to_jsonb(g) gift_raw,to_jsonb(st) student_raw
  from public.gift_cards g join public.students st on st.id=g.recipient_student_id where g.id='49000000-0000-0000-0000-000000000010';
grant select on public.manual_legacy_gift_cases,public.manual_legacy_gift_before,public.manual_legacy_student_before to authenticated;
grant select on public.manual_legacy_null_before to authenticated;
\elif :{?manual_legacy_verify}
create function public.atomic_assert(ok boolean,label text) returns void language plpgsql as $$
begin
  if ok is distinct from true then raise exception 'FAIL: %',label; end if;
  raise notice 'PASS: %',label;
end $$;
create function public.atomic_reject(statement text,expected text,code text default 'P0001') returns void language plpgsql as $$
declare rejected boolean := false;
begin
  begin execute statement;
  exception when others then
    if sqlstate<>code or sqlerrm not like expected then raise; end if;
    rejected:=true;
  end;
  perform public.atomic_assert(rejected,'reject: '||expected);
end $$;
set request.jwt.claim.sub = '09000000-0000-0000-0000-000000000001';
set request.jwt.claim.role = 'authenticated';
set role authenticated;
select public.atomic_assert(count(*)=11 and bool_and(to_jsonb(st)=b.raw),'full cold chain preserves every real gift-created raw student mirror')
  from public.students st join public.manual_legacy_student_before b using(id);
select public.atomic_assert(count(*)=11 and bool_and(to_jsonb(g)=b.raw),'full cold chain preserves unused, partial, exhausted, consumed, cancelled, expired, reassigned and unassigned gifts')
  from public.gift_cards g join public.manual_legacy_gift_before b using(id);
select public.atomic_reject(format($q$select public.approve_student_manual_credit(%L::uuid,gen_random_uuid(),'reconcile_legacy',4,4,
  'mesa',private.membership_today()-1,private.membership_today()+30,'Do not duplicate a gift mirror','Legacy gift evidence')$q$,student_id),
  'Legacy balance may mirror a historical gift card; reconciliation is forbidden') from public.manual_legacy_gift_cases order by n;
select public.atomic_assert(count(*)=11 and bool_and(can_approve_manual_credit and not can_reconcile_legacy),
  'UI reconciliation veto uses the same all-state direct/name/email ambiguity criterion')
  from public.student_credit_profile v join public.manual_legacy_gift_cases c on c.student_id=v.student_id;
select public.approve_student_manual_credit(student_id,gen_random_uuid(),'new_manual',1,4,'mesa',private.membership_today()-1,
  private.membership_today()+30,'Independent additional grant, not a gift mirror','Signed separate class grant')
  from public.manual_legacy_gift_cases order by n;
select public.atomic_assert(count(*)=11 and bool_and(mode='new_manual' and quantity=1 and remaining_classes=1),
  'independent evidence-backed new_manual remains possible for every gift ambiguity')
  from public.manual_credit_entitlements_with_balance v join public.manual_legacy_gift_cases c on c.student_id=v.student_id;
select public.atomic_assert(count(*)=11 and bool_and(to_jsonb(st)=b.raw),'denied reconciliation and independent grants never rewrite raw gift-created balances/categories/payments')
  from public.students st join public.manual_legacy_student_before b using(id);
select public.atomic_assert(count(*)=11 and bool_and(to_jsonb(g)=b.raw),'ambiguity veto and independent grants never auto-link or change any historical gift source')
  from public.gift_cards g join public.manual_legacy_gift_before b using(id);
select public.atomic_assert(count(*)=4 and bool_and(g.recipient_student_id is null),
  'normalized full-name, first-name, recipient-email and recipient-as-email matches remain unassigned')
  from public.gift_cards g join public.manual_legacy_gift_cases c on c.gift_id=g.id where c.n in(6,7,8,9);
-- Assigned-other homonyms are conservative denial candidates, never financial owners.
insert into public.students(id,sede_id,full_name,name,student_category,classes_remaining) values
  ('19000000-0000-0000-0000-000000000001','39000000-0000-0000-0000-000000000001','LegacyMirror1 Person','LegacyMirror1','temporal',4),
  ('19000000-0000-0000-0000-000000000006','39000000-0000-0000-0000-000000000001','LegacyMirror6 Person','LegacyMirror6','temporal',4);
select public.atomic_assert(not can_reconcile_legacy,'assigned-other homonym is conservatively blocked without asserting gift ownership')
  from public.student_credit_profile where student_id='19000000-0000-0000-0000-000000000001';
select public.atomic_assert(not can_reconcile_legacy,'unassigned name ambiguity vetoes all homonyms without choosing an identity')
  from public.student_credit_profile where student_id='19000000-0000-0000-0000-000000000006';
select public.atomic_reject($q$select public.approve_student_manual_credit('19000000-0000-0000-0000-000000000006',gen_random_uuid(),
  'reconcile_legacy',4,4,'mesa',private.membership_today()-1,private.membership_today()+30,'Homonym is ambiguous','Evidence')$q$,
  'Legacy balance may mirror a historical gift card; reconciliation is forbidden');
select public.atomic_reject($q$select public.approve_student_manual_credit('19000000-0000-0000-0000-000000000001',gen_random_uuid(),'reconcile_legacy',4,4,
  'mesa',private.membership_today()-1,private.membership_today()+30,'Homonym does not establish ownership','Separate evidence')$q$,
  'Legacy balance may mirror a historical gift card; reconciliation is forbidden');
select public.approve_student_manual_credit('19000000-0000-0000-0000-000000000001',gen_random_uuid(),'new_manual',1,4,
  'mesa',private.membership_today()-1,private.membership_today()+30,'Separate additional grant despite conservative homonym veto','Independent signed evidence');
select public.atomic_assert(recipient_student_id=c.student_id,'homonym veto never reassigns the actual gift UUID recipient')
  from public.gift_cards g join public.manual_legacy_gift_cases c on c.gift_id=g.id where c.n=1;
reset role;
create table public.manual_veto_history_before as select to_jsonb(v) raw from private.manual_legacy_gift_vetoes v;
select public.atomic_assert(count(*)=11 and bool_and(v.observation='rollout' and v.observed_balance=4
  and v.student_snapshot=b.raw and v.gift_snapshot=g.raw and v.recorded_by is null),
  'rollout denial records preserve original UUIDs and complete source/student observations without choosing ownership')
  from private.manual_legacy_gift_vetoes v join public.manual_legacy_gift_cases c on c.student_id=v.student_id and c.gift_id=v.gift_card_id
  join public.manual_legacy_student_before b on b.id=v.student_id join public.manual_legacy_gift_before g on g.id=v.gift_card_id;
select public.atomic_assert(match_basis='normalized_label_or_email'
  and gift_snapshot->>'recipient_student_id'='19000000-0000-0000-0000-000000000012',
  'pre-rollout A-to-B reassignment retains a denial for A from the old label, not a guessed ownership link')
  from private.manual_legacy_gift_vetoes where gift_card_id='49000000-0000-0000-0000-000000000012'
    and student_id=(select student_id from public.manual_legacy_gift_cases where n=12);
insert into auth.users(id,email) values('09000000-0000-0000-0000-000000000002','legacy-metadata-employee@example.invalid');
insert into public.profiles(id,email,role) values('09000000-0000-0000-0000-000000000002','legacy-metadata-employee@example.invalid','staff');
insert into public.sede_members(sede_id,user_id,role) values('39000000-0000-0000-0000-000000000001','09000000-0000-0000-0000-000000000002','staff');
set role authenticated;
set request.jwt.claim.sub = '09000000-0000-0000-0000-000000000002';
update public.gift_cards set recipient_student_id='19000000-0000-0000-0000-000000000012',
  recipient='Changed Gift Recipient',recipient_email='changed-gift@example.invalid'
  where id='49000000-0000-0000-0000-000000000001';
-- Clearing the only surviving label/email evidence must not erase earlier roll-out observations.
update public.gift_cards set recipient_student_id='19000000-0000-0000-0000-000000000012',
  recipient='Changed Historical Recipient',recipient_email='changed-history@example.invalid'
  where id in('49000000-0000-0000-0000-000000000006','49000000-0000-0000-0000-000000000008','49000000-0000-0000-0000-000000000009',
    '49000000-0000-0000-0000-000000000012');
select public.atomic_reject($q$select * from private.manual_legacy_gift_vetoes$q$,'permission denied%','42501');
select public.atomic_reject($q$insert into private.manual_legacy_gift_vetoes default values$q$,'permission denied%','42501');
select public.atomic_reject($q$select private.record_manual_gift_veto(null::public.gift_cards,null::public.students,'gift_write')$q$,'permission denied%','42501');
set request.jwt.claim.sub = '09000000-0000-0000-0000-000000000001';
select public.atomic_reject(format($q$select public.approve_student_manual_credit(%L::uuid,gen_random_uuid(),'reconcile_legacy',4,4,
  'mesa',private.membership_today()-1,private.membership_today()+30,'Metadata changes cannot free a mirrored scalar','Evidence')$q$,student_id),
  'Legacy balance may mirror a historical gift card; reconciliation is forbidden') from public.manual_legacy_gift_cases where n in(1,6,8,9,12) order by n;
select public.atomic_assert(count(*)=11 and bool_and(not can_reconcile_legacy),
  'RPC and UI capability remain blocked after ordinary authenticated recipient/name/email changes')
  from public.student_credit_profile v join public.manual_legacy_gift_cases c on c.student_id=v.student_id;
select public.atomic_assert(count(*)=11 and bool_and(to_jsonb(st)=b.raw),'authenticated gift reassignment never modifies A raw scalar, category, dates or payment')
  from public.students st join public.manual_legacy_student_before b using(id);
select public.atomic_assert(count(*)=11 and bool_and((to_jsonb(g)-array['recipient_student_id','recipient','recipient_email'])=
  (b.raw-array['recipient_student_id','recipient','recipient_email'])),'only the explicitly requested gift identity/labels changed; no finance or term rewrite')
  from public.gift_cards g join public.manual_legacy_gift_before b using(id);
select public.atomic_assert(recipient_student_id='19000000-0000-0000-0000-000000000012' and sessions_used=0 and num_classes=4,
  'unused reassigned gift stays B gift, never a substitute or auto-linked A source') from public.gift_cards where id='49000000-0000-0000-0000-000000000001';
select public.atomic_assert(count(*)=0,'reassignment never creates a reconciled or automatic manual allocation')
  from public.student_manual_credit_entitlements where mode='reconcile_legacy';
select public.approve_student_manual_credit(student_id,gen_random_uuid(),'new_manual',1,4,'mesa',private.membership_today()-1,
  private.membership_today()+30,'Separate approved addition after gift reassignment','Independent evidence, not old gift funds')
  from public.manual_legacy_gift_cases where n=1;
select public.atomic_assert(count(*)=2 and bool_and(mode='new_manual' and quantity=1),
  'durable denial never blocks a separately explicit new_manual grant') from public.student_manual_credit_entitlements
  where student_id=(select student_id from public.manual_legacy_gift_cases where n=1);
begin;
update public.students set full_name='Changed Student Label',name='Changed Student',email='changed-student@example.invalid'
  where id=(select student_id from public.manual_legacy_gift_cases where n=1);
select public.atomic_assert(not can_reconcile_legacy,'student label/email changes also cannot erase the durable veto')
  from public.student_credit_profile where student_id=(select student_id from public.manual_legacy_gift_cases where n=1);
select public.atomic_reject(format($q$select public.approve_student_manual_credit(%L::uuid,gen_random_uuid(),'reconcile_legacy',4,4,
  'mesa',private.membership_today()-1,private.membership_today()+30,'Renaming does not clear old observations','Evidence')$q$,student_id),
  'Legacy balance may mirror a historical gift card; reconciliation is forbidden') from public.manual_legacy_gift_cases where n=1;
rollback;
-- A future association must leave a sticky denial even after every live match disappears.
insert into public.students(id,sede_id,full_name,name,student_category,classes_remaining) values
  ('19000000-0000-0000-0000-000000000101','39000000-0000-0000-0000-000000000001','Future Veto Original','Future Veto','temporal',4),
  ('19000000-0000-0000-0000-000000000102','39000000-0000-0000-0000-000000000001','Future Veto Target','Future Target','temporal',0),
  ('19000000-0000-0000-0000-000000000103','39000000-0000-0000-0000-000000000001','Later Positive Original','Later Positive','temporal',0);
select public.atomic_assert(can_reconcile_legacy,'positive independent observation has no veto before a gift association')
  from public.student_credit_profile where student_id='19000000-0000-0000-0000-000000000101';
set request.jwt.claim.sub = '09000000-0000-0000-0000-000000000002';
insert into public.gift_cards(id,sede_id,recipient,recipient_student_id,num_classes,type,activated_at,payment_status) values
  ('49000000-0000-0000-0000-000000000101','39000000-0000-0000-0000-000000000001','Unrelated Initial Gift Label','19000000-0000-0000-0000-000000000101',4,'modelado',private.membership_today(),'paid'),
  ('49000000-0000-0000-0000-000000000103','39000000-0000-0000-0000-000000000001','Unrelated Later Gift Label','19000000-0000-0000-0000-000000000103',4,'modelado',private.membership_today(),'paid');
update public.students set classes_remaining=4 where id='19000000-0000-0000-0000-000000000103';
update public.gift_cards set recipient_student_id='19000000-0000-0000-0000-000000000102',
  recipient='Completely Changed Gift Label',recipient_email='different-gift@example.invalid'
  where id in('49000000-0000-0000-0000-000000000101','49000000-0000-0000-0000-000000000103');
update public.students set full_name='Completely Changed Student Label',name='Changed',email='different-student@example.invalid'
  where id in('19000000-0000-0000-0000-000000000101','19000000-0000-0000-0000-000000000103');
set request.jwt.claim.sub = '09000000-0000-0000-0000-000000000001';
select public.atomic_assert(count(*)=2 and bool_and(not can_reconcile_legacy and legacy_observed_balance=4),
  'gift first-link and later-positive student observers retain vetoes after recipient and all labels/emails change')
  from public.student_credit_profile where student_id in('19000000-0000-0000-0000-000000000101','19000000-0000-0000-0000-000000000103');
select public.atomic_reject(format($q$select public.approve_student_manual_credit(%L::uuid,gen_random_uuid(),'reconcile_legacy',4,4,
  'mesa',private.membership_today()-1,private.membership_today()+30,'Future association must remain denied','Evidence')$q$,student_id),
  'Legacy balance may mirror a historical gift card; reconciliation is forbidden')
  from public.student_credit_profile where student_id in('19000000-0000-0000-0000-000000000101','19000000-0000-0000-0000-000000000103');
select public.atomic_reject($q$update public.students set id='19000000-0000-0000-0000-000000000104'
  where id='19000000-0000-0000-0000-000000000101'$q$, 'Observed legacy student identity is immutable');
reset role;
select public.atomic_assert(count(*)=2 and bool_and(recorded_by='09000000-0000-0000-0000-000000000002' and observed_balance=4
  and match_basis='recipient_id' and student_snapshot->>'classes_remaining'='4'
  and gift_snapshot->>'recipient_student_id'=student_id::text
  and observation=case when student_id='19000000-0000-0000-0000-000000000101' then 'gift_write' else 'student_write' end),
  'private trigger records only denial snapshots with the legitimate employee actor, never financial ownership or allocation')
  from private.manual_legacy_gift_vetoes where student_id in('19000000-0000-0000-0000-000000000101','19000000-0000-0000-0000-000000000103');
select public.atomic_assert(not exists(select 1 from public.student_manual_credit_entitlements where student_id in
  ('19000000-0000-0000-0000-000000000101','19000000-0000-0000-0000-000000000103'))
  and not exists(select 1 from public.gift_card_movements where gift_card_id in
  ('49000000-0000-0000-0000-000000000101','49000000-0000-0000-0000-000000000103')),
  'future denial observations do not create manual entitlements or financial movements');
select public.atomic_assert(not exists(select 1 from public.manual_veto_history_before b where not exists (
  select 1 from private.manual_legacy_gift_vetoes v where to_jsonb(v)=b.raw)),
  'all first-observation UUIDs, snapshots, actors and timestamps survive reassignment and label/email edits unchanged');
select public.atomic_assert(not private.manual_gift_veto_match(g,st) and private.manual_legacy_gift_ambiguous(st.id),
  'no live matching gift is needed once the conservative denial has been observed')
  from public.manual_legacy_gift_cases c join public.students st on st.id=c.student_id join public.gift_cards g on g.id=c.gift_id where c.n=1;
select public.atomic_reject($q$update private.manual_legacy_gift_vetoes set observed_balance=999$q$,'Session history is append-only','42501');
select public.atomic_reject($q$delete from private.manual_legacy_gift_vetoes$q$,'Session history is append-only','42501');
set role service_role;
select public.atomic_reject($q$select * from private.manual_legacy_gift_vetoes$q$,'permission denied%','42501');
select public.atomic_reject($q$truncate private.manual_legacy_gift_vetoes$q$,'permission denied%','42501');
set role authenticated;
set request.jwt.claim.sub = '09000000-0000-0000-0000-000000000001';
select public.save_session_reservation('29000000-0000-0000-0000-000000000010',gen_random_uuid(),0,'39000000-0000-0000-0000-000000000001',
  jsonb_build_object('date',(private.membership_today()+5)::text,'start_time',(private.membership_today()+5)::text||'T12:00:00Z',
    'end_time',(private.membership_today()+5)::text||'T13:00:00Z','class_type','mesa','capacity',1),array[student_id],
  jsonb_build_object(student_id::text,id)) from public.manual_legacy_null_before;
select public.atomic_reject(format($q$select public.save_session_attendance('29000000-0000-0000-0000-000000000010',gen_random_uuid(),1,
  %L::jsonb,true,null)$q$,jsonb_build_array(jsonb_build_object('student_id',student_id,'status','present'))),
  'Presence requires valid original credit%') from public.manual_legacy_null_before;
select public.atomic_reject(format($q$select public.approve_session_exception('29000000-0000-0000-0000-000000000010',%L::uuid,
  gen_random_uuid(),1,'no_credit','Unknown activation does not mean no allocation')$q$,student_id),
  'No-credit exception cannot bypass available credit%') from public.manual_legacy_null_before;
select public.save_session_attendance('29000000-0000-0000-0000-000000000010',gen_random_uuid(),1,
  jsonb_build_array(jsonb_build_object('student_id',student_id,'status','absent')),true,null) from public.manual_legacy_null_before;
select public.atomic_assert(is_pending and original_gift_card_id='49000000-0000-0000-0000-000000000010',
  'null legacy activation fails closed to an original-source pending no-show') from public.session_pending_penalties where session_id='29000000-0000-0000-0000-000000000010';
select public.atomic_assert(to_jsonb(g)=b.gift_raw and to_jsonb(st)=b.student_raw and g.activated_at is null
  and not exists(select 1 from public.gift_card_movements where gift_card_id=g.id)
  and not exists(select 1 from public.gift_card_operation_receipts where gift_card_id=g.id)
  and not exists(select 1 from public.session_credit_movements where session_id='29000000-0000-0000-0000-000000000010'),
  'unknown activation leaves raw historical source/student and all finance ledgers untouched')
  from public.manual_legacy_null_before b join public.gift_cards g on g.id=b.id join public.students st on st.id=b.student_id;
set request.jwt.claim.sub = '00000000-0000-0000-0000-000000000001';
select public.atomic_assert(not private.manual_legacy_gift_ambiguous(student_id),'ambiguity helper never exposes another sede student through its authenticated view grant')
  from public.manual_legacy_gift_cases order by n;
reset role;
\else
reset role;
set request.jwt.claim.sub = '00000000-0000-0000-0000-000000000001';
set request.jwt.claim.role = 'authenticated';
set timezone = 'UTC';
-- Genuine old policy2 receipt with a numeric 32-digit gift UUID, before strict validation.
set role authenticated;
insert into public.students(id,sede_id,full_name,name,student_category,classes_remaining)
  values(public.business_id(1,170),public.business_id(3,1),'Numeric Receipt Student','Numeric Receipt','temporal',0);
insert into public.gift_cards(id,sede_id,recipient,recipient_student_id,num_classes,type,activated_at,payment_status)
  values('41000000-0000-0000-0000-000000000170',public.business_id(3,1),'Numeric Receipt Student',public.business_id(1,170),2,'modelado',private.membership_today(),'paid');
select public.save_session_reservation(public.business_id(2,170),public.business_id(6,170),0,public.business_id(3,1),
  public.business_metadata(25,12),array[public.business_id(1,170)],jsonb_build_object(public.business_id(1,170)::text,41000000000000000000000000000170::numeric));
reset role;
create table public.manual_numeric_receipt_before as select to_jsonb(r) raw from public.session_operation_receipts r where session_id=public.business_id(2,170);
grant select on public.manual_numeric_receipt_before to authenticated;
create table public.manual_preservation_before as
  select 'students' kind, to_jsonb(t) raw from public.students t
  union all select 'sessions', to_jsonb(t) from public.sessions t
  union all select 'roster', to_jsonb(t) from public.session_students t
  union all select 'credits', to_jsonb(t) from public.session_credit_movements t
  union all select 'receipts', to_jsonb(t) from public.session_operation_receipts t
  union all select 'penalties', to_jsonb(t) from public.session_business_penalties t
  union all select 'exceptions', to_jsonb(t) from public.session_business_exceptions t
  union all select 'periods', to_jsonb(t) from public.student_membership_periods t
  union all select 'gifts', to_jsonb(t) from public.gift_cards t
   union all select 'gift_movements', to_jsonb(t) from public.gift_card_movements t
   union all select 'gift_receipts', to_jsonb(t) from public.gift_card_operation_receipts t
   union all select 'adjustments', to_jsonb(t) from public.student_membership_class_adjustments t
  union all select 'waivers', to_jsonb(t) from public.session_business_waivers t
  union all select 'billing', to_jsonb(t) from public.session_business_billing t
  union all select 'events', to_jsonb(t) from public.session_business_events t;
create table public.manual_view_before as select to_jsonb(v) raw from public.session_business_state v;
create table public.manual_columns_before as select attname::text name, attnum from pg_attribute
  where attrelid = 'public.session_business_state'::regclass and attnum > 0 and not attisdropped;
\i /tmp/manual-policy.sql
select public.atomic_assert(not exists (select kind,raw from public.manual_preservation_before except (
  select 'students',to_jsonb(t) from public.students t
  union all select 'sessions',to_jsonb(t) from public.sessions t
  union all select 'roster',to_jsonb(t)-'manual_credit_id' from public.session_students t
  union all select 'credits',to_jsonb(t)-'manual_credit_id' from public.session_credit_movements t
  union all select 'receipts',to_jsonb(t) from public.session_operation_receipts t
  union all select 'penalties',to_jsonb(t)-'manual_credit_id' from public.session_business_penalties t
  union all select 'exceptions',to_jsonb(t)-'manual_credit_id' from public.session_business_exceptions t
  union all select 'periods',to_jsonb(t) from public.student_membership_periods t
  union all select 'gifts',to_jsonb(t) from public.gift_cards t
   union all select 'gift_movements',to_jsonb(t) from public.gift_card_movements t
   union all select 'gift_receipts',to_jsonb(t) from public.gift_card_operation_receipts t
   union all select 'adjustments',to_jsonb(t) from public.student_membership_class_adjustments t
  union all select 'waivers',to_jsonb(t) from public.session_business_waivers t
  union all select 'billing',to_jsonb(t) from public.session_business_billing t
  union all select 'events',to_jsonb(t) from public.session_business_events t)), 'manual migration preserves every historical row and receipt');
select public.atomic_assert(not exists (select 1 from public.manual_view_before b where not exists (
  select 1 from public.session_business_state v where to_jsonb(v)-array['funding_manual_credit_id','exception_manual_credit_id',
    'penalty_manual_credit_id','settlement_id','settlement_debit_id','settlement_reason','settled_by','settled_at','settlement_revision']=b.raw)),
  'existing business view values unchanged; only nine appended columns');
select public.atomic_assert(not exists (select 1 from public.manual_columns_before b join pg_attribute a on a.attnum=b.attnum
  and a.attrelid='public.session_business_state'::regclass where a.attname<>b.name), 'existing view column ordinals stable');
select public.atomic_assert(count(*)=1 and bool_and(pronargs=8 and pronargdefaults=2), 'single PostgREST reservation signature with two defaults')
  from pg_proc where pronamespace='public'::regnamespace and proname='save_session_reservation';
select public.atomic_assert(proargnames=array['p_student_id','p_request_key','p_mode','p_quantity','p_expected_legacy_balance',
  'p_activity','p_starts_on','p_ends_on','p_reason','p_evidence'] and prorettype='jsonb'::regtype,
  'manual approval exact named RPC contract') from pg_proc where oid='public.approve_student_manual_credit(uuid,uuid,text,integer,integer,text,date,date,text,text)'::regprocedure;
select public.atomic_assert(proargnames=array['p_penalty_id','p_request_key','p_expected_revision','p_reason'] and prorettype='jsonb'::regtype,
  'settlement RPC has no source selector') from pg_proc where oid='public.settle_student_penalty(uuid,uuid,bigint,text)'::regprocedure;

create function public.manual_approve(n integer, key integer, mode text, qty integer, expected integer) returns jsonb
language sql security invoker as $$
  select public.approve_student_manual_credit(public.business_id(1,n), public.business_id(6,key), mode, qty, expected,
    'mesa',private.membership_today()-10,private.membership_today()+90,'Owner-approved class entitlement','Original signed credit evidence');
$$;
create function public.manual_entitlement(n integer, key integer) returns uuid language sql as $$
  select id from public.student_manual_credit_entitlements where student_id=public.business_id(1,n) and request_key=public.business_id(6,key);
$$;
create function public.manual_reserve(session integer, student integer, key integer, days integer default 0, hour integer default 18) returns jsonb
language sql security invoker as $$
  select public.save_session_reservation(public.business_id(2,session),public.business_id(6,session),0,public.business_id(3,1),
    public.business_metadata(days,hour),array[public.business_id(1,student)],'{}',
    jsonb_build_object(public.business_id(1,student)::text,public.manual_entitlement(student,key)));
$$;
create function public.manual_settle(session integer, key integer, revision bigint, reason text default 'Owner resolves original-source incident') returns jsonb
language sql security invoker as $$
  select public.settle_student_penalty((select id from public.session_business_penalties where session_id=public.business_id(2,session)),
    public.business_id(6,key),revision,reason);
$$;
-- Test-only failure injection proves the whole RPC rolls back even AFTER a debit.
create function public.manual_test_reject_settlement() returns trigger language plpgsql as $$
begin
  if current_setting('app.manual_test_reject_settlement',true)='on' then
    raise exception 'Injected settlement persistence failure';
  end if;
  return new;
end $$;
create trigger manual_test_reject_settlement before insert on public.student_penalty_settlements
  for each row execute function public.manual_test_reject_settlement();
-- Test-only definer includes the otherwise unreadable private denial history in rollback checks.
create function public.manual_financial_fingerprint() returns text language sql stable security definer set search_path = '' as $$
  select md5(string_agg(kind||raw::text,E'\n' order by kind,raw::text)) from (
    select 'students' kind,to_jsonb(t) raw from public.students t
    union all select 'sessions',to_jsonb(t) from public.sessions t
    union all select 'roster',to_jsonb(t) from public.session_students t
    union all select 'credits',to_jsonb(t) from public.session_credit_movements t
    union all select 'receipts',to_jsonb(t) from public.session_operation_receipts t
    union all select 'periods',to_jsonb(t) from public.student_membership_periods t
    union all select 'adjustments',to_jsonb(t) from public.student_membership_class_adjustments t
    union all select 'gifts',to_jsonb(t) from public.gift_cards t
    union all select 'gift_movements',to_jsonb(t) from public.gift_card_movements t
    union all select 'gift_receipts',to_jsonb(t) from public.gift_card_operation_receipts t
    union all select 'penalties',to_jsonb(t) from public.session_business_penalties t
    union all select 'exceptions',to_jsonb(t) from public.session_business_exceptions t
    union all select 'waivers',to_jsonb(t) from public.session_business_waivers t
    union all select 'billing',to_jsonb(t) from public.session_business_billing t
    union all select 'events',to_jsonb(t) from public.session_business_events t
    union all select 'entitlements',to_jsonb(t) from public.student_manual_credit_entitlements t
    union all select 'settlements',to_jsonb(t) from public.student_penalty_settlements t
    union all select 'gift_vetoes',to_jsonb(t) from private.manual_legacy_gift_vetoes t
  ) history;
$$;
create function public.manual_assert_settlement_rollback(session integer,key integer,revision bigint) returns void
language plpgsql security invoker as $$
declare before text := public.manual_financial_fingerprint();
begin
  perform set_config('app.manual_test_reject_settlement','on',true);
  perform public.atomic_reject(format('select public.manual_settle(%s,%s,%s)',session,key,revision),
    'Injected settlement persistence failure');
  perform set_config('app.manual_test_reject_settlement','off',true);
  perform public.atomic_assert(before=public.manual_financial_fingerprint(),
    'settlement post-debit failure preserves complete financial/history fingerprint: '||session);
end $$;
set role authenticated;
select public.atomic_assert(public.save_session_reservation(public.business_id(2,170),public.business_id(6,170),0,public.business_id(3,1),
  public.business_metadata(25,12),array[public.business_id(1,170)],jsonb_build_object(public.business_id(1,170)::text,41000000000000000000000000000170::numeric))-'replayed'
  =(select (raw->'result')-'replayed' from public.manual_numeric_receipt_before), 'authorized exact numeric old policy2 receipt replays its original result');
select public.atomic_reject($q$select public.save_session_reservation(public.business_id(2,170),public.business_id(6,170),0,public.business_id(3,1),
  public.business_metadata(25,12),array[public.business_id(1,170)],jsonb_build_object(public.business_id(1,170)::text,'41000000-0000-0000-0000-000000000170'))$q$,
  'Idempotency key conflicts with original session intent');
select public.atomic_reject($q$select public.save_session_reservation(public.business_id(2,170),gen_random_uuid(),1,public.business_id(3,1),
  '{}',array[public.business_id(1,170)],jsonb_build_object(public.business_id(1,170)::text,41000000000000000000000000000170::numeric))$q$,
  'Funding links must identify roster students with UUID strings');
select public.atomic_reject($q$select public.save_session_reservation(public.business_id(2,171),gen_random_uuid(),0,public.business_id(3,1),
  public.business_metadata(25,14),array[public.business_id(1,170)],jsonb_build_object(public.business_id(1,170)::text,41000000000000000000000000000170::numeric))$q$,
  'Funding links must identify roster students with UUID strings');
select public.atomic_assert(to_jsonb(r)=b.raw,'old numeric receipt remains byte-for-byte unchanged after replay, conflict and strict fresh rejection')
  from public.session_operation_receipts r cross join public.manual_numeric_receipt_before b where r.session_id=public.business_id(2,170);
set request.jwt.claim.sub = '01000000-0000-0000-0000-000000000005';
select public.atomic_reject($q$select public.save_session_reservation(public.business_id(2,170),public.business_id(6,170),0,public.business_id(3,1),
  public.business_metadata(25,12),array[public.business_id(1,170)],jsonb_build_object(public.business_id(1,170)::text,41000000000000000000000000000170::numeric))$q$,
  'Session not accessible','42501');
set request.jwt.claim.sub = '00000000-0000-0000-0000-000000000001';
insert into public.students(id,sede_id,full_name,name,surname,student_category,classes_remaining,payment_status)
  select public.business_id(1,n),public.business_id(3,1),'Manual Student '||n,'Manual',n::text,'temporal',
    case when n=101 then null when n in (100,102,103) then 3 when n=116 then 1 else 0 end,'pending'
  from generate_series(100,160) n;
reset role;
update public.students set archived_at=private.membership_today()-1 where id=public.business_id(1,103);
create table public.manual_students_before as select id,to_jsonb(st) raw from public.students st where id in
  (select public.business_id(1,n) from generate_series(100,160) n);
grant select on public.manual_students_before to authenticated;
set role authenticated;

-- Staff, non-owning superadmin, foreign owner and linked integration are not owners.
set request.jwt.claim.sub = '01000000-0000-0000-0000-000000000001';
select public.atomic_reject($q$select public.manual_approve(100,100,'reconcile_legacy',3,3)$q$, 'Only this workshop owner may approve manual credits','42501');
set request.jwt.claim.sub = '01000000-0000-0000-0000-000000000003';
select public.atomic_reject($q$select public.manual_approve(100,100,'reconcile_legacy',3,3)$q$, 'Only this workshop owner may approve manual credits','42501');
set request.jwt.claim.sub = '01000000-0000-0000-0000-000000000002';
select public.atomic_reject($q$select public.manual_approve(100,100,'reconcile_legacy',3,3)$q$, 'Only this workshop owner may approve manual credits','42501');
select public.atomic_assert(count(*)=0,'foreign owner has no credit profile rows') from public.student_credit_profile where student_id=public.business_id(1,100);
set request.jwt.claim.sub = '01000000-0000-0000-0000-000000000005';
select public.atomic_reject($q$select public.manual_approve(100,100,'reconcile_legacy',3,3)$q$, 'Only this workshop owner may approve manual credits','42501');
select public.atomic_assert(count(*)=0,'integration cannot read credit profiles') from public.student_credit_profile;
set request.jwt.claim.sub = '00000000-0000-0000-0000-000000000001';
select public.atomic_reject($q$select public.manual_approve(100,100,'reconcile_legacy',3,2)$q$, 'Stale legacy balance observation','40001');
select public.atomic_reject($q$select public.manual_approve(100,100,'reconcile_legacy',2,3)$q$, 'Known legacy reconciliation must allocate the exact positive observed balance');
select public.atomic_reject($q$select public.manual_approve(104,104,'reconcile_legacy',1,0)$q$, 'Known legacy reconciliation must allocate the exact positive observed balance');
select public.atomic_reject($q$select public.manual_approve(101,101,'reconcile_legacy',2,null)$q$, 'Known legacy reconciliation must allocate the exact positive observed balance');
select public.atomic_assert(can_approve_manual_credit and not can_reconcile_legacy and legacy_observed_balance is null,
  'UI must disable unknown legacy reconciliation but can offer separate evidence-backed new_manual')
  from public.student_credit_profile where student_id=public.business_id(1,101);
select public.atomic_assert(can_reconcile_legacy,'UI permits known positive unreconciled nonmembership balance')
  from public.student_credit_profile where student_id=public.business_id(1,100);
select public.atomic_reject($q$select public.manual_approve(17,100,'reconcile_legacy',4,4)$q$, 'Membership balance cannot be duplicated as manual credit');
select public.atomic_reject($q$select public.approve_student_manual_credit(public.business_id(1,100),gen_random_uuid(),'new_manual',1,3,
  'mesa',private.membership_today(),private.membership_today()+1,'reason',' ')$q$, 'Explicit mode, positive quantity, activity, finite dates, reason and evidence required');
select public.atomic_reject($q$select public.approve_student_manual_credit(public.business_id(1,100),gen_random_uuid(),'new_manual',1,3,
  'mesa','infinity','infinity','reason','evidence')$q$, 'Explicit mode, positive quantity, activity, finite dates, reason and evidence required');
select public.manual_approve(100,100,'reconcile_legacy',3,3);
select public.manual_approve(101,101,'new_manual',2,null);
select public.manual_approve(102,102,'new_manual',1,3);
select public.manual_approve(103,103,'reconcile_legacy',3,3);
select public.atomic_assert(public.manual_approve(100,100,'reconcile_legacy',3,3)->>'replayed'='true','manual approval retries durable receipt');
select public.atomic_reject($q$select public.manual_approve(100,100,'new_manual',3,3)$q$, 'Idempotency key conflicts with original manual credit intent');
select public.atomic_reject($q$select public.manual_approve(100,199,'reconcile_legacy',3,3)$q$, 'Legacy balance is already reconciled');
select public.atomic_assert(not can_reconcile_legacy,'UI disallows a second reconciliation of the same snapshot')
  from public.student_credit_profile where student_id=public.business_id(1,100);
begin;
set local request.jwt.claim.role = '';
select public.atomic_reject($q$select public.manual_approve(100,100,'reconcile_legacy',3,3)$q$, 'Only this workshop owner may approve manual credits','42501');
select public.atomic_assert(count(*)=0,'missing authenticated claim cannot read manual credit profile') from public.student_credit_profile;
rollback;
set request.jwt.claim.sub = '01000000-0000-0000-0000-000000000001';
select public.atomic_reject($q$select public.manual_approve(100,100,'reconcile_legacy',3,3)$q$, 'Only this workshop owner may approve manual credits','42501');
select public.atomic_assert(not can_approve_manual_credit and not can_reconcile_legacy and jsonb_array_length(manual_credits)=1,
  'employee can read approved credit but cannot approve or reconcile, including replay')
  from public.student_credit_profile where student_id=public.business_id(1,100);
set request.jwt.claim.sub = '01000000-0000-0000-0000-000000000003';
select public.atomic_reject($q$select public.manual_approve(100,100,'reconcile_legacy',3,3)$q$, 'Only this workshop owner may approve manual credits','42501');
set request.jwt.claim.sub = '01000000-0000-0000-0000-000000000004';
select public.atomic_reject($q$select public.manual_approve(100,100,'reconcile_legacy',3,3)$q$, 'Only this workshop owner may approve manual credits','42501');
select public.atomic_assert(count(*)=0,'unlinked reader cannot read manual entitlements') from public.student_manual_credit_entitlements;
