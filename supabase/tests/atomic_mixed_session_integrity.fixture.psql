select public.atomic_reject($q$truncate public.session_activity_blocks cascade$q$,'permission denied%','42501');
select public.atomic_assert(not has_table_privilege('authenticated','public.session_activity_blocks','trigger')
  and not has_table_privilege('authenticated','public.session_activity_block_students','references'), 'no inherited trigger/reference escalation grants');
select public.atomic_reject($q$select private.save_session_reservation_before_atomic_mixed(public.business_id(2,500),gen_random_uuid(),7,public.business_id(3,1),'{}',array[public.business_id(1,500)],'{}','{}')$q$,'permission denied%','42501');
set request.jwt.claim.sub='01000000-0000-0000-0000-000000000003';
select public.atomic_reject($q$update public.session_activity_blocks set teacher_id=null$q$,'permission denied%','42501');
select public.atomic_assert(count(*)>0,'real SuperAdmin retains global mixed reads only') from public.session_activity_business_state;
select public.atomic_reject($q$select public.manual_settle(505,527,2)$q$,'Only this workshop owner may settle penalties','42501');
reset role;
begin;
delete from public.sede_members where user_id=public.business_id(0,3);
set local role authenticated;
select public.mix_reject($q$select public.mix_save(540,528,0,array[540],jsonb_build_array(public.mix_block('mesa',null,1,array[540])))$q$,'Session not accessible','42501');
rollback;
set role authenticated;
set request.jwt.claim.sub='01000000-0000-0000-0000-000000000004';
select public.atomic_assert(count(*)=0,'reader cannot read blocks') from public.session_activity_blocks;
select public.atomic_assert(count(*)=0,'reader cannot read block students') from public.session_activity_block_students;
select public.atomic_assert(count(*)=0,'reader cannot read mixed financial projections') from public.session_activity_business_state;
set request.jwt.claim.sub='01000000-0000-0000-0000-000000000005';
select public.atomic_assert(count(*)=0,'linked integration gets no mixed block read leak') from public.session_activity_blocks;
select public.mix_reject($q$select public.mix_save(540,528,0,array[540],jsonb_build_array(public.mix_block('mesa',null,1,array[540])))$q$,'Session not accessible','42501');
set role service_role;
select public.atomic_reject($q$insert into public.session_activity_blocks default values$q$,'permission denied%','42501');
select public.atomic_reject($q$truncate public.session_activity_block_students$q$,'permission denied%','42501');
select public.atomic_reject($q$select * from private.mixed_session_writers$q$,'permission denied%','42501');
reset role;
set request.jwt.claim.sub='00000000-0000-0000-0000-000000000001';
select public.atomic_assert(bool_and(to_jsonb(st)=b.raw),'all temporal raw class/payment/category/archive/date state survives mixed operations') from public.students st join public.mixed_students_before b using(id);
select public.atomic_assert(count(*)=0,'atomic writer capabilities never escape successful operations') from private.mixed_session_writers;
-- Even database-owner maintenance cannot use a caller GUC as the atomic path.
begin;
set local app.atomic_mixed='true';
select public.atomic_reject($q$insert into public.session_activity_blocks(session_id,sede_id,activity_type,capacity)
  values(public.business_id(2,500),public.business_id(3,2),'mesa',1)$q$,'Mixed state requires the atomic reservation path','42501');
rollback;
-- Controlled disposable capability permits testing the FK itself, independently of the guard.
begin;
insert into private.mixed_session_writers values(pg_backend_pid(),txid_current(),public.business_id(2,501));
select public.atomic_reject($q$insert into public.session_activity_blocks(session_id,sede_id,activity_type,capacity)
  values(public.business_id(2,501),public.business_id(3,2),'mesa',1)$q$,'%mixed_block_session_sede_fk%','23503');
rollback;
set role authenticated;
-- Distinct race fixtures: two attempts for the last seat and identical attendance retries.
select public.mix_save(530,530,0,array[530],jsonb_build_array(public.mix_block('mesa',null,1,array[530]),public.mix_block('torno',null,1,'{}')), '{}','{}',20);
select public.manual_approve(533,533,'new_manual',1,0);
select public.mix_save(533,533,0,array[533],jsonb_build_array(public.mix_block('mesa',null,1,array[533])), '{}',jsonb_build_object(public.business_id(1,533)::text,public.manual_entitlement(533,533)),20);
reset role;
\o
