\set ON_ERROR_STOP on
\o /dev/null
reset role;
set request.jwt.claim.sub='00000000-0000-0000-0000-000000000001';
set request.jwt.claim.role='authenticated';
set timezone='UTC';
\i /tmp/mixed-1.sql
\i /tmp/mixed-2.sql
\i /tmp/mixed-3.sql
\i /tmp/mixed-4.sql
\i /tmp/mixed-5.sql
-- Genuine preceding mixed-policy history, including a charged row with no recorded activity provenance.
set role authenticated;
insert into public.students(id,sede_id,full_name,name,student_category,membership_tier)
  values(public.business_id(1,490),public.business_id(3,1),'Legacy Mixed Member','Legacy Mixed','membresia','gold');
select public.confirm_student_membership_payment(current_membership_period_id) from public.students where id=public.business_id(1,490);
select public.save_session_reservation(public.business_id(2,490),public.business_id(6,490),0,public.business_id(3,1),
  public.business_metadata(5,8,1)||'{"class_type":"mixto"}',array[public.business_id(1,490)],'{}','{}');
insert into public.session_activity_blocks(id,session_id,sede_id,activity_type,capacity)
  values(public.business_id(7,490),public.business_id(2,490),public.business_id(3,1),'mesa',1);
insert into public.session_activity_block_students(block_id,session_id,student_id)
  values(public.business_id(7,490),public.business_id(2,490),public.business_id(1,490));
select public.save_session_attendance(public.business_id(2,490),public.business_id(6,491),1,public.business_attendance(490,'present'),true,null);
-- Real policy1 parents predate policy2. The preceding mixed migration permits their conversion.
insert into public.students(id,sede_id,full_name,name,student_category,membership_tier)
  values(public.business_id(1,480),public.business_id(3,1),'Policy1 Mixed Paid Member','Policy1 Mixed','membresia','gold');
select public.confirm_student_membership_payment(current_membership_period_id) from public.students where id=public.business_id(1,480);
reset role;
insert into public.sessions(id,sede_id,date,start_time,end_time,class_type,capacity,attendance_policy_version)
  select public.business_id(2,n),public.business_id(3,1),public.business_metadata(5,(n-480)*2+6)->>'date',
    (public.business_metadata(5,(n-480)*2+6)->>'start_time')::timestamptz,
    (public.business_metadata(5,(n-480)*2+6)->>'end_time')::timestamptz,'mesa',1,1 from generate_series(480,482) n;
set role authenticated;
select public.save_session_reservation(public.business_id(2,480),public.business_id(6,480),0,public.business_id(3,1),
  public.business_metadata(5,6,1)||'{"class_type":"mixto"}',array[public.business_id(1,480)],'{}','{}');
select public.save_session_reservation(public.business_id(2,481),public.business_id(6,481),0,public.business_id(3,1),
  public.business_metadata(5,8,1)||'{"class_type":"mixto"}',array[public.business_id(1,480)],'{}','{}');
select public.save_session_reservation(public.business_id(2,482),public.business_id(6,482),0,public.business_id(3,1),
  public.business_metadata(5,10,1),array[public.business_id(1,480)],'{}','{}');
select public.save_session_attendance(public.business_id(2,481),public.business_id(6,1481),1,public.business_attendance(480,'present'),true,null);
select public.atomic_assert(st.classes_remaining=3 and p.payment_status='paid' and st.archived_at is null
  and private.membership_today()+5 between p.starts_on and p.ends_on,
  'pre-follow-up policy1 mixed reproducer has known positive paid unarchived valid original membership')
  from public.students st join public.student_membership_periods p on p.id=st.current_membership_period_id where st.id=public.business_id(1,480);
select public.save_session_reservation(public.business_id(2,483),public.business_id(6,483),0,public.business_id(3,1),
  public.business_metadata(5,2,1)||'{"class_type":"mixto"}',array[public.business_id(1,490)],'{}','{}');
select public.save_session_reservation(public.business_id(2,484),public.business_id(6,484),0,public.business_id(3,1),
  public.business_metadata(5,4,1)||'{"class_type":"mixto"}',array[public.business_id(1,490)],'{}','{}');
reset role;
-- The old single-column FKs permit these historic cross-sede teacher/block anomalies.
insert into public.session_activity_blocks(id,session_id,sede_id,activity_type,teacher_id,capacity) values
  (public.business_id(7,483),public.business_id(2,483),public.business_id(3,1),'mesa','70000000-0000-0000-0000-000000000001',1),
  (public.business_id(7,484),public.business_id(2,484),public.business_id(3,2),'mesa',null,1);
insert into public.session_activity_block_students(block_id,session_id,student_id) values
  (public.business_id(7,483),public.business_id(2,483),public.business_id(1,490)),
  (public.business_id(7,484),public.business_id(2,484),public.business_id(1,490));
update public.session_students set activity_type='mesa' where session_id in(public.business_id(2,483),public.business_id(2,484));
create table public.mixed_policy1_receipt_before as select to_jsonb(r) raw from public.session_operation_receipts r
  where session_id=public.business_id(2,481) and request_key=public.business_id(6,1481);
grant select on public.mixed_policy1_receipt_before to authenticated;
create table public.mixed_history_before as
  select 'students' kind,to_jsonb(t) raw from public.students t
  union all select 'sessions',to_jsonb(t) from public.sessions t
  union all select 'roster',to_jsonb(t) from public.session_students t
  union all select 'credits',to_jsonb(t) from public.session_credit_movements t
  union all select 'receipts',to_jsonb(t) from public.session_operation_receipts t
  union all select 'periods',to_jsonb(t) from public.student_membership_periods t
  union all select 'adjustments',to_jsonb(t) from public.student_membership_class_adjustments t
  union all select 'gifts',to_jsonb(t) from public.gift_cards t
  union all select 'gift_movements',to_jsonb(t) from public.gift_card_movements t
  union all select 'gift_receipts',to_jsonb(t) from public.gift_card_operation_receipts t
  union all select 'penalties',to_jsonb(t) from public.session_business_penalties t
  union all select 'exceptions',to_jsonb(t) from public.session_business_exceptions t
  union all select 'waivers',to_jsonb(t) from public.session_business_waivers t
  union all select 'billing',to_jsonb(t) from public.session_business_billing t
  union all select 'events',to_jsonb(t) from public.session_business_events t
  union all select 'manual',to_jsonb(t) from public.student_manual_credit_entitlements t
  union all select 'settlements',to_jsonb(t) from public.student_penalty_settlements t
  union all select 'vetoes',to_jsonb(t) from private.manual_legacy_gift_vetoes t
  union all select 'blocks',to_jsonb(t) from public.session_activity_blocks t
  union all select 'block_roster',to_jsonb(t) from public.session_activity_block_students t;
\i /tmp/atomic-mixed.sql
create function public.mixed_fingerprint() returns text language sql stable security definer set search_path='' as $$
  select md5(string_agg(kind||raw::text,E'\n' order by kind,raw::text)) from (
    select 'students' kind,to_jsonb(t) raw from public.students t
    union all select 'sessions',to_jsonb(t) from public.sessions t
    union all select 'roster',to_jsonb(t) from public.session_students t
    union all select 'credits',to_jsonb(t) from public.session_credit_movements t
    union all select 'receipts',to_jsonb(t) from public.session_operation_receipts t
    union all select 'periods',to_jsonb(t) from public.student_membership_periods t
    union all select 'adjustments',to_jsonb(t) from public.student_membership_class_adjustments t
    union all select 'gifts',to_jsonb(t) from public.gift_cards t
    union all select 'gift_movements',to_jsonb(t) from public.gift_card_movements t
    union all select 'gift_receipts',to_jsonb(t) from public.gift_card_operation_receipts t
    union all select 'penalties',to_jsonb(t) from public.session_business_penalties t
    union all select 'exceptions',to_jsonb(t) from public.session_business_exceptions t
    union all select 'waivers',to_jsonb(t) from public.session_business_waivers t
    union all select 'billing',to_jsonb(t) from public.session_business_billing t
    union all select 'events',to_jsonb(t) from public.session_business_events t
    union all select 'manual',to_jsonb(t) from public.student_manual_credit_entitlements t
    union all select 'settlements',to_jsonb(t) from public.student_penalty_settlements t
    union all select 'vetoes',to_jsonb(t) from private.manual_legacy_gift_vetoes t
    union all select 'blocks',to_jsonb(t) from public.session_activity_blocks t
    union all select 'block_roster',to_jsonb(t) from public.session_activity_block_students t
    union all select 'origins',to_jsonb(t) from private.mixed_session_reservations t
    union all select 'writers',to_jsonb(t) from private.mixed_session_writers t
  ) history;
$$;
select public.atomic_assert(not exists(select 1 from public.mixed_history_before b where not exists(select 1 from (
  select 'students' kind,to_jsonb(t) raw from public.students t
  union all select 'sessions',to_jsonb(t) from public.sessions t
  union all select 'roster',to_jsonb(t) from public.session_students t
  union all select 'credits',to_jsonb(t) from public.session_credit_movements t
  union all select 'receipts',to_jsonb(t) from public.session_operation_receipts t
  union all select 'periods',to_jsonb(t) from public.student_membership_periods t
  union all select 'adjustments',to_jsonb(t) from public.student_membership_class_adjustments t
  union all select 'gifts',to_jsonb(t) from public.gift_cards t
  union all select 'gift_movements',to_jsonb(t) from public.gift_card_movements t
  union all select 'gift_receipts',to_jsonb(t) from public.gift_card_operation_receipts t
  union all select 'penalties',to_jsonb(t) from public.session_business_penalties t
  union all select 'exceptions',to_jsonb(t) from public.session_business_exceptions t
  union all select 'waivers',to_jsonb(t) from public.session_business_waivers t
  union all select 'billing',to_jsonb(t) from public.session_business_billing t
  union all select 'events',to_jsonb(t) from public.session_business_events t
  union all select 'manual',to_jsonb(t) from public.student_manual_credit_entitlements t
  union all select 'settlements',to_jsonb(t) from public.student_penalty_settlements t
  union all select 'vetoes',to_jsonb(t) from private.manual_legacy_gift_vetoes t
  union all select 'blocks',to_jsonb(t) from public.session_activity_blocks t
  union all select 'block_roster',to_jsonb(t) from public.session_activity_block_students t
) n where n.kind=b.kind and n.raw=b.raw)), 'follow-up preserves every existing raw/history row including old mixed rows; no column exclusions');
select public.atomic_assert(count(*)=0,'old mixed sources are not inferred or backfilled') from private.mixed_session_reservations;
select public.atomic_assert(count(*)=1 and bool_and(pronargs=9 and pronargdefaults=3), 'one nine-argument PostgREST reservation RPC with three defaults')
  from pg_proc where pronamespace='public'::regnamespace and proname='save_session_reservation';
create function public.mix_block(activity text,teacher uuid,cap integer,students integer[],block uuid default null) returns jsonb language sql as $$
  select jsonb_build_object('activity_type',activity,'teacher_id',teacher,'capacity',cap,'student_ids',
    coalesce((select jsonb_agg(public.business_id(1,n) order by n) from unnest(students) n),'[]'))
    ||case when block is null then '{}'::jsonb else jsonb_build_object('id',block) end;
$$;
create function public.mix_save(session integer,key integer,revision bigint,students integer[],blocks jsonb,gifts jsonb default '{}',manual jsonb default '{}',hour integer default 12)
returns jsonb language sql security invoker as $$
  select public.save_session_reservation(public.business_id(2,session),public.business_id(6,key),revision,public.business_id(3,1),
    public.business_metadata(5,hour,(select sum((v->>'capacity')::int)::int from jsonb_array_elements(blocks) v))||'{"class_type":"mixto","teacher_id":null}',
    array(select public.business_id(1,n) from unnest(students) n),gifts,manual,blocks);
$$;
create function public.mix_attend(session integer,key integer,revision bigint,students integer[],statuses text[],finalize boolean default true) returns jsonb language sql as $$
  select public.save_session_attendance(public.business_id(2,session),public.business_id(6,key),revision,
    (select jsonb_agg(jsonb_build_object('student_id',public.business_id(1,n),'status',status) order by n) from unnest(students,statuses) a(n,status)),finalize,null);
$$;
create function public.mix_reject(statement text,expected text,code text default 'P0001') returns void language plpgsql as $$
declare before text:=public.mixed_fingerprint(); begin
  perform public.atomic_reject(statement,expected,code);
  perform public.atomic_assert(before=public.mixed_fingerprint(),'mixed failure rolls back complete public/private financial/history fingerprint');
end $$;
set role authenticated;
select public.mix_reject($q$select public.save_session_attendance(public.business_id(2,480),gen_random_uuid(),1,public.business_attendance(480,'present'),true,null)$q$,
  'Fresh attendance is unsupported for historical policy1 mixed sessions');
select public.mix_reject($q$select public.save_session_attendance(public.business_id(2,480),gen_random_uuid(),1,public.business_attendance(480,'present'),false,null)$q$,
  'Fresh attendance is unsupported for historical policy1 mixed sessions');
select public.mix_reject($q$select public.save_session_attendance(public.business_id(2,480),gen_random_uuid(),1,public.business_attendance(480,'absent'),true,null)$q$,
  'Fresh attendance is unsupported for historical policy1 mixed sessions');
select public.mix_reject($q$select public.save_session_attendance(public.business_id(2,481),gen_random_uuid(),2,public.business_attendance(480,'absent'),true,null)$q$,
  'Fresh attendance is unsupported for historical policy1 mixed sessions');
reset role;
select public.atomic_assert(st.classes_remaining=3 and s.attendance_policy_version=1 and s.class_type='mixto'
  and s.revision=1 and s.completed_at is null and e.attendance='pending' and e.activity_type is null
  and not exists(select 1 from public.session_credit_movements where session_id=s.id)
  and not exists(select 1 from public.session_operation_receipts where session_id=s.id and operation='attendance')
  and not exists(select 1 from public.session_business_events where session_id=s.id)
  and not exists(select 1 from private.mixed_session_reservations where session_id=s.id),
  'fresh policy1 mixed rejection preserves budget, historical policy, pending roster, receipts, events and missing provenance')
  from public.sessions s join public.session_students e on e.session_id=s.id join public.students st on st.id=e.student_id where s.id=public.business_id(2,480);
set role authenticated;
select public.atomic_assert(public.save_session_attendance(public.business_id(2,481),public.business_id(6,1481),1,
  public.business_attendance(480,'present'),true,null)->>'replayed'='true'
  and public.save_session_attendance(public.business_id(2,481),public.business_id(6,1481),1,
    public.business_attendance(480,'present'),true,null)-'replayed'=(b.raw->'result')-'replayed',
  'authorized exact pre-follow-up policy1 mixed attendance receipt replays its original stable snapshot')
  from public.mixed_policy1_receipt_before b;
select public.mix_reject($q$select public.save_session_attendance(public.business_id(2,481),public.business_id(6,1481),1,public.business_attendance(480,'absent'),true,null)$q$,
  'Idempotency key conflicts with original session intent');
select public.mix_reject($q$select private.save_session_attendance_before_atomic_mixed(public.business_id(2,480),gen_random_uuid(),1,public.business_attendance(480,'present'),true,null)$q$,
  'permission denied%','42501');
select public.mix_reject($q$select private.save_session_attendance_v1(public.business_id(2,480),gen_random_uuid(),1,public.business_attendance(480,'present'),true,null)$q$,
  'permission denied%','42501');
set request.jwt.claim.sub='01000000-0000-0000-0000-000000000001';
select public.atomic_assert(public.save_session_attendance(public.business_id(2,481),public.business_id(6,1481),1,public.business_attendance(480,'present'),true,null)->>'replayed'='true',
  'actual sede employee may replay the exact historical policy1 mixed receipt without new writes');
select public.mix_reject($q$select private.save_session_attendance_before_manual(public.business_id(2,480),gen_random_uuid(),1,public.business_attendance(480,'present'),true,null)$q$,
  'permission denied%','42501');
set request.jwt.claim.sub='01000000-0000-0000-0000-000000000002';
select public.mix_reject($q$select public.save_session_attendance(public.business_id(2,481),public.business_id(6,1481),1,public.business_attendance(480,'present'),true,null)$q$,
  'Session not accessible','42501');
set request.jwt.claim.sub='01000000-0000-0000-0000-000000000004';
select public.mix_reject($q$select public.save_session_attendance(public.business_id(2,481),public.business_id(6,1481),1,public.business_attendance(480,'present'),true,null)$q$,
  'Session not accessible','42501');
set request.jwt.claim.sub='01000000-0000-0000-0000-000000000005';
select public.mix_reject($q$select public.save_session_attendance(public.business_id(2,481),public.business_id(6,1481),1,public.business_attendance(480,'present'),true,null)$q$,
  'Session not accessible','42501');
reset role;
begin;
delete from public.sede_members where user_id=public.business_id(0,3);
set local role authenticated;
set local request.jwt.claim.sub='01000000-0000-0000-0000-000000000003';
select public.mix_reject($q$select public.save_session_attendance(public.business_id(2,481),public.business_id(6,1481),1,public.business_attendance(480,'present'),true,null)$q$,
  'Session not accessible','42501');
rollback;
set role service_role;
select public.mix_reject($q$select private.save_session_attendance_before_atomic_mixed(public.business_id(2,480),gen_random_uuid(),1,public.business_attendance(480,'present'),true,null)$q$,
  'permission denied%','42501');
set role authenticated;
set request.jwt.claim.sub='00000000-0000-0000-0000-000000000001';
select public.atomic_assert(to_jsonb(r)=b.raw and st.classes_remaining=3 and (select count(*) from public.session_credit_movements where session_id=r.session_id)=1,
  'old policy1 mixed receipt and original single debit survive authorized replays and denied actor/private bypass attempts unchanged')
  from public.session_operation_receipts r cross join public.mixed_policy1_receipt_before b cross join public.students st
  where r.session_id=public.business_id(2,481) and r.request_key=public.business_id(6,1481) and st.id=public.business_id(1,480);
select public.save_session_attendance(public.business_id(2,482),public.business_id(6,1482),1,public.business_attendance(480,'present'),true,null);
select public.atomic_assert(st.classes_remaining=2 and s.attendance_policy_version=1 and s.class_type='mesa'
  and s.completed_at is not null and (select count(*) from public.session_credit_movements where session_id=s.id)=1,
  'classic policy1 fresh attendance retains its shipped paid-membership debit behavior')
  from public.sessions s join public.students st on st.id=public.business_id(1,480) where s.id=public.business_id(2,482);
select public.atomic_assert(public.save_session_reservation(public.business_id(2,490),public.business_id(6,490),0,public.business_id(3,1),
  public.business_metadata(5,8,1)||'{"class_type":"mixto"}',array[public.business_id(1,490)],'{}','{}')->>'replayed'='true',
  'authorized old eight-argument mixed receipt replays unchanged despite unknown provenance');
select public.mix_reject($q$select public.save_session_attendance(public.business_id(2,490),gen_random_uuid(),2,public.business_attendance(490,'absent'),true,null)$q$,
  'Mixed activity assignment requires reconciliation');
select public.atomic_assert(not activity_source_verified and funding_activity_type is null,'old mixed projections do not claim an inferred financial activity')
  from public.session_activity_business_state where session_id=public.business_id(2,490);
select public.mix_reject($q$select public.save_session_attendance(public.business_id(2,483),gen_random_uuid(),1,public.business_attendance(490,'present'),true,null)$q$,
  'Mixed activity assignment requires reconciliation');
select public.mix_reject($q$select public.save_session_attendance(public.business_id(2,484),gen_random_uuid(),1,public.business_attendance(490,'present'),true,null)$q$,
  'Mixed activity assignment requires reconciliation');
select public.atomic_assert(count(*)=2 and bool_and(not activity_source_verified and funding_activity_type is null),
  'NOT VALID historic block/teacher sede anomalies remain preserved but fail closed in financial projections')
  from public.session_activity_business_state where session_id in(public.business_id(2,483),public.business_id(2,484));
insert into public.students(id,sede_id,full_name,name,student_category,membership_tier,classes_remaining,payment_status)
  select public.business_id(1,n),public.business_id(3,1),'Atomic Mixed '||n,'Atomic Mixed '||n,
    case when n in(500,510) then 'membresia' else 'temporal' end,case when n in(500,510) then 'gold' end,0,null
  from generate_series(500,550) n;
select public.confirm_student_membership_payment(current_membership_period_id) from public.students where id in(public.business_id(1,500),public.business_id(1,510));
insert into public.teachers(id,sede_id,name) values(public.business_id(8,500),public.business_id(3,1),'Mesa Mixed Teacher'),
  (public.business_id(8,501),public.business_id(3,1),'Torno Mixed Teacher');
select public.manual_approve(501,501,'new_manual',3,0);
insert into public.gift_cards(id,sede_id,recipient,recipient_student_id,num_classes,type,activated_at,payment_status)
  values(public.business_id(4,502),public.business_id(3,1),'Atomic Mixed 502',public.business_id(1,502),3,'torno',private.membership_today(),'paid'),
    (public.business_id(4,505),public.business_id(3,1),'Atomic Mixed 505',public.business_id(1,505),3,'torno',private.membership_today()+2,'paid'),
    (public.business_id(4,506),public.business_id(3,1),'Atomic Mixed 506',public.business_id(1,506),3,'torno',private.membership_today(),'pending');
reset role;
update public.gift_cards set payment_status=null,status='pending' where id=public.business_id(4,506);
create table public.mixed_students_before as select id,to_jsonb(st) raw from public.students st where id in(select public.business_id(1,n) from generate_series(501,550) n) and id<>public.business_id(1,510);
grant select on public.mixed_students_before to authenticated;
set role authenticated;
select public.mix_save(500,500,0,array[500,501,502],jsonb_build_array(
  public.mix_block('mesa',public.business_id(8,500),2,array[500,501]),public.mix_block('torno',public.business_id(8,501),1,array[502])),
  jsonb_build_object(public.business_id(1,502)::text,public.business_id(4,502)),jsonb_build_object(public.business_id(1,501)::text,public.manual_entitlement(501,501)));
select public.atomic_assert(count(*)=3 and bool_and(activity_source_verified) and count(*) filter(where funding_activity_type='mesa')=2,
  'atomic reservation persists block IDs and per-student effective activities before funding') from public.session_activity_business_state where session_id=public.business_id(2,500);
select public.mix_attend(500,501,1,array[500,501,502],array['present','present','present'],false);
select public.atomic_assert(count(*)=0,'mixed provisional attendance has zero financial effects') from public.session_credit_movements where session_id=public.business_id(2,500);
select public.mix_attend(500,502,2,array[500,501,502],array['present','present','present']);
select public.atomic_assert(count(*)=3 and count(*) filter(where disposition='manual_credit' and activity_type='mesa')=1
  and count(*) filter(where disposition='gift_card' and activity_type='torno')=1
