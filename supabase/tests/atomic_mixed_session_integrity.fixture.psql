    case when n in(500,510) then 'membresia' else 'temporal' end,case when n in(500,510) then 'gold' end,0,null
  from generate_series(500,550) n;
select public.confirm_student_membership_payment(current_membership_period_id) from public.students where id in(public.business_id(1,500),public.business_id(1,510));
insert into public.teachers(id,sede_id,name) values(public.business_id(8,500),public.business_id(3,1),'Mesa Mixed Teacher'),
  (public.business_id(8,501),public.business_id(3,1),'Torno Mixed Teacher');
select public.manual_approve(501,501,'new_manual',3,0);
insert into public.gift_cards(id,sede_id,recipient,recipient_student_id,num_classes,type,activated_at,payment_status)
  values(public.business_id(4,502),public.business_id(3,1),'Atomic Mixed 502',public.business_id(1,502),3,'torno',private.membership_today(),'paid'),
    (public.business_id(4,505),public.business_id(3,1),'Atomic Mixed 505',public.business_id(1,505),3,'torno',private.membership_today()+2,'paid'),
    (public.business_id(4,506),public.business_id(3,1),'Atomic Mixed 506',public.business_id(1,506),3,'torno',private.membership_today(),'pending');
reset role;
update public.gift_cards set payment_status=null,status='active' where id=public.business_id(4,506);
create table public.mixed_students_before as select id,to_jsonb(st) raw from public.students st where id in(select public.business_id(1,n) from generate_series(501,550) n) and id<>public.business_id(1,510);
grant select on public.mixed_students_before to authenticated;
set role authenticated;
select public.mix_save(500,500,0,array[500,501,502],jsonb_build_array(
  public.mix_block('mesa',public.business_id(8,500),2,array[500,501]),public.mix_block('torno',public.business_id(8,501),1,array[502])),
  jsonb_build_object(public.business_id(1,502)::text,public.business_id(4,502)),jsonb_build_object(public.business_id(1,501)::text,public.manual_entitlement(501,501)));
select public.atomic_assert(count(*)=3 and bool_and(activity_source_verified) and count(*) filter(where funding_activity_type='mesa')=2,
  'atomic reservation persists block IDs and per-student effective activities before funding') from public.session_activity_business_state where session_id=public.business_id(2,500);
select public.mix_attend(500,501,1,array[500,501,502],array['present','present','present'],false);
select public.atomic_assert(count(*)=0,'mixed provisional attendance has zero financial effects') from public.session_credit_movements where session_id=public.business_id(2,500);
select public.mix_attend(500,502,2,array[500,501,502],array['present','present','present']);
select public.atomic_assert(count(*)=3 and count(*) filter(where disposition='manual_credit' and activity_type='mesa')=1
  and count(*) filter(where disposition='gift_card' and activity_type='torno')=1
  and count(*) filter(where disposition='current_period' and activity_type='mesa')=1,
  'manual Mesa, paid gift Torno and membership each debit exactly one at finalization') from public.session_credit_activity_state where session_id=public.business_id(2,500);
select public.atomic_assert(public.mix_attend(500,502,2,array[500,501,502],array['present','present','present'])->>'replayed'='true','mixed finalization receipt replay debits once');
select public.mix_save(501,503,0,array[500,501,502,503],jsonb_build_array(public.mix_block('mesa',null,3,array[500,501,503]),public.mix_block('torno',null,1,array[502])),
  jsonb_build_object(public.business_id(1,502)::text,public.business_id(4,502)),jsonb_build_object(public.business_id(1,501)::text,public.manual_entitlement(501,501)),14);
select public.mix_reject($q$select public.mix_attend(501,504,1,array[500,501,502,503],array['present','present','present','present'])$q$,'Presence requires valid original credit%');
select public.mix_reject($q$select public.mix_save(502,505,0,array[501],jsonb_build_array(public.mix_block('torno',null,1,array[501])),
  '{}',jsonb_build_object(public.business_id(1,501)::text,public.manual_entitlement(501,501)),16)$q$,'Selected manual credit must match student, sede and block activity');
select public.mix_reject($q$select public.mix_save(502,505,0,array[502],jsonb_build_array(public.mix_block('mesa',null,1,array[502])),
  jsonb_build_object(public.business_id(1,502)::text,public.business_id(4,502)),'{}',16)$q$,'Selected gift must match student, sede and block activity');
select public.mix_reject($q$select public.mix_save(502,505,0,array[504,507],jsonb_build_array(public.mix_block('mesa',null,1,array[504,507])))$q$,'Activity block capacity exceeded');
select public.mix_reject($q$select public.mix_save(502,505,0,array[504],jsonb_build_array(public.mix_block('mesa',null,1,array[504]),public.mix_block('torno',null,1,array[504])))$q$,
  'Each active roster student must occur in exactly one block%');
select public.mix_reject($q$select public.mix_save(502,505,0,array[504],jsonb_build_array(public.mix_block('mesa',null,1,array[504]),public.mix_block('mesa',null,1,array[504])))$q$,'Duplicate activity blocks');
select public.mix_reject($q$select public.mix_save(502,505,0,array[504],jsonb_build_array(public.mix_block('mesa','70000000-0000-0000-0000-000000000002',1,array[504])))$q$,'Block teacher must belong to the session sede');
select public.mix_reject($q$select public.mix_save(502,505,0,array[504],jsonb_build_array(public.mix_block('mesa',null,1,array[504])),
  '{}',jsonb_build_object(public.business_id(1,504)::text,public.manual_entitlement(501,501)))$q$,'Selected manual credit must match student, sede and block activity');
select public.mix_save(505,506,0,array[505],jsonb_build_array(public.mix_block('torno',null,1,array[505])),jsonb_build_object(public.business_id(1,505)::text,public.business_id(4,505)), '{}',16);
select public.mix_reject($q$select public.mix_attend(505,507,1,array[505],array['present'])$q$,'Presence requires valid original credit%');
